main() {
  local arg do_change=0 do_change_method=0
  REQUESTED_PORT="${REQUESTED_PORT:-}"
  REQUESTED_METHOD="${REQUESTED_METHOD:-}"
  # 先分派 --info / --change-port / --change-method / --self-test，不进入完整安装。
  for arg in "$@"; do
    if [[ "$arg" == "--info" ]]; then
      if [[ $# -ne 1 ]]; then
        die "--info 需要单独使用，且不接受其他参数。用法：sudo bash ${SCRIPT_NAME} --info"
      fi
      run_info
      return
    fi
  done
  if [[ $# -eq 0 ]]; then
    run_install
    return
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        return 0
        ;;
      --self-test)
        SANDBOX=1
        SKIP_SYSTEMD=1
        self_test
        return
        ;;
      --yes)
        ASSUME_YES=1
        shift
        ;;
      --sandbox)
        SANDBOX=1
        SKIP_SYSTEMD=1
        PREFIX="${2:-}"
        shift 2 || die "--sandbox 需要目录"
        ;;
      --change-port)
        do_change=1
        shift
        if [[ $# -gt 0 && "$1" != --* ]]; then
          REQUESTED_PORT="$1"
          shift
        fi
        ;;
      --change-method)
        do_change_method=1
        shift
        if [[ $# -gt 0 && "$1" != --* ]]; then
          REQUESTED_METHOD="$1"
          shift
        fi
        ;;
      *)
        die "未知参数：$1。使用 --help 查看说明。"
        ;;
    esac
  done
  if [[ $do_change -eq 1 && $do_change_method -eq 1 ]]; then
    die "--change-port 与 --change-method 请分别运行，不要写在同一条命令里。"
  fi
  if [[ $do_change -eq 1 ]]; then
    run_change_port
  elif [[ $do_change_method -eq 1 ]]; then
    run_change_method
  else
    run_install
  fi
}

if [[ "${SS_NODE_ASSUME_YES:-}" == "1" ]]; then
  ASSUME_YES=1
fi

main "$@"
