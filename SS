  [[ "$(canonical_method aes-256-gcm)" == "$METHOD_AES256" ]] || { err "aes-256-gcm 规范化失败"; rc=1; }
  [[ "$(canonical_method chacha20-poly1305)" == "$METHOD_CHACHA" ]] || { err "chacha 别名失败"; rc=1; }
