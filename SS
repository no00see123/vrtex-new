ensure_sysuser() {
  if id -u "$SYSUSER" >/dev/null 2>&1; then
    return 0
  fi
  useradd --system --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin "$SYSUSER"
}

# 目录权限（最小可运行，不为方便而 0777，服务不以 root 跑）：
#   PREFIX、BIN_DIR     root:root 0755
#   ETC_DIR             root:ss-node 0750；config 0640 供服务只读；state/link 0600 仅 root
#   LOG_DIR             ss-node:ss-node 0750，供服务写入（当前默认日志走 journald）
fix_permissions() {
  mkdir -p "$BIN_DIR" "$ETC_DIR" "$LOG_DIR"
  chmod 0755 "$PREFIX" "$BIN_DIR"
  chmod 0750 "$ETC_DIR"
  chmod 0750 "$LOG_DIR"
  if id -u "$SYSUSER" >/dev/null 2>&1; then
    chown root:root "$PREFIX" "$BIN_DIR" 2>/dev/null || true
    chown root:"$SYSUSER" "$ETC_DIR"
    chown "$SYSUSER":"$SYSUSER" "$LOG_DIR"
    if [[ -e "$BIN_DIR/xray" ]]; then
      chown root:root "$BIN_DIR/xray"
      chmod 0755 "$BIN_DIR/xray"
    fi
  fi
  if [[ -e "$CONFIG_FILE" ]]; then
    chmod 0640 "$CONFIG_FILE"
    if id -u "$SYSUSER" >/dev/null 2>&1; then
      chown root:"$SYSUSER" "$CONFIG_FILE"
    fi
  fi
  if [[ -e "$STATE_FILE" ]]; then
    chmod 0600 "$STATE_FILE"
    chown root:root "$STATE_FILE" 2>/dev/null || true
  fi
  if [[ -e "$LINK_FILE" ]]; then
    chmod 0600 "$LINK_FILE"
    chown root:root "$LINK_FILE" 2>/dev/null || true
  fi
}

layout_allows_service_user() {
  python3 - "$1" "$2" "$3" "$4" "$5" "$6" <<'PYCODE'
import os,stat,sys
prefix, etc_dir, cfg, log_dir = sys.argv[1:5]
uid, gid = int(sys.argv[5]), int(sys.argv[6])

def allows(path, op):
    st=os.stat(path)
    mode=st.st_mode
    if uid == st.st_uid:
        bits={"read":stat.S_IRUSR,"write":stat.S_IWUSR,"exec":stat.S_IXUSR}[op]
    elif gid == st.st_gid:
        bits={"read":stat.S_IRGRP,"write":stat.S_IWGRP,"exec":stat.S_IXGRP}[op]
    else:
        bits={"read":stat.S_IROTH,"write":stat.S_IWOTH,"exec":stat.S_IXOTH}[op]
    return bool(mode & bits)

def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)

if not allows(prefix,"exec"):
    fail("安装根目录对服务用户不可进入：%s" % prefix)
if not allows(etc_dir,"exec") or not allows(etc_dir,"read"):
    fail("配置目录对服务用户不可进入或列出：%s" % etc_dir)
if os.path.exists(cfg) and not allows(cfg,"read"):
    fail("服务用户读不了配置：%s" % cfg)
if not allows(log_dir,"exec") or not allows(log_dir,"write"):
    fail("服务用户无法写入日志目录：%s" % log_dir)
for path,name in ((etc_dir,"配置目录"),(cfg,"配置文件") if os.path.exists(cfg) else (etc_dir,"配置目录")):
    if not os.path.exists(path):
        continue
    st=os.stat(path)
    if st.st_mode & stat.S_IWOTH:
        fail("%s 对其他人可写，权限过宽：%s mode=%o" % (name, path, st.st_mode & 0o777))
    if st.st_mode & 0o777 == 0o777:
        fail("%s 权限为 0777，已拒绝：%s" % (name, path))
print("layout ok")
PYCODE
}

assert_runtime_access() {
  if ! id -u "$SYSUSER" >/dev/null 2>&1; then
    local mode
    mode="$(stat -c '%a' "$ETC_DIR" 2>/dev/null || true)"
    if [[ "$mode" == "777" ]]; then
      die "配置目录权限异常（${ETC_DIR} 为 777）。"
    fi
    return 0
  fi
  local uid gid
  uid="$(id -u "$SYSUSER")"
  gid="$(id -g "$SYSUSER")"
  if ! layout_allows_service_user "$PREFIX" "$ETC_DIR" "$CONFIG_FILE" "$LOG_DIR" "$uid" "$gid"; then
    die "目录权限不足以让服务用户读取配置并写入日志目录，已中止。"
  fi
  if [[ "$(id -u)" == "0" && $SANDBOX -eq 0 ]]; then
    local probe rc
    probe="${LOG_DIR}/.ss-write-probe.$$"
    set +e
    if command -v runuser >/dev/null 2>&1; then
      runuser -u "$SYSUSER" -- sh -c "test -r '$CONFIG_FILE' && test -x '$PREFIX' && test -x '$ETC_DIR' && touch '$probe'"
      rc=$?
    else
      su -s /bin/sh "$SYSUSER" -c "test -r '$CONFIG_FILE' && test -x '$PREFIX' && test -x '$ETC_DIR' && touch '$probe'"
      rc=$?
    fi
    set -e
    rm -f "$probe"
    if [[ $rc -ne 0 ]]; then
      die "以服务用户 ${SYSUSER} 实测：无法读取配置或在 ${LOG_DIR} 创建文件。已中止。"
    fi
    info "已确认服务用户 ${SYSUSER} 可读取配置并写入日志目录。"
  fi
}

maybe_open_ports() {
  local mode="${OPEN_PORT_MODE}"
  if [[ -z "$mode" ]]; then
    if [[ -t 0 ]]; then
      mode='ask'
    else
      mode='no'
    fi
  fi
  info "需要放行本机 TCP ${PORT} 与 UDP ${PORT}。本脚本不会改默认策略或 SSH。云防火墙/安全组只能你在控制台自行放行这两个端口。若前面还有中转，还需要在中转侧同步后端端口映射。"
  case "$mode" in
    no|NO|0)
      info "已跳过本机端口放行。请自行放行 TCP/UDP ${PORT}，并检查云防火墙/安全组。"
      return 0
      ;;
    yes|YES|1)
      ;;
    ask|ASK)
      if confirm_firewall "是否仅放行本机 TCP ${PORT} 与 UDP ${PORT}（不改默认策略、不改 SSH）？"; then
        mode='yes'
      else
        info "已跳过本机端口放行。若在云服务器上，还需在安全组放行 TCP/UDP ${PORT}。"
        return 0
      fi
      ;;
    *) die "SS_NODE_OPEN_PORT 只能是 yes、no 或 ask。" ;;
  esac
  if [[ $SANDBOX -eq 1 ]]; then
    info "沙箱模式：不修改防火墙。"
    return 0
  fi
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
    ufw allow "${PORT}/tcp" comment 'ss-node' || die "ufw 放行 TCP 失败。"
    ufw allow "${PORT}/udp" comment 'ss-node' || die "ufw 放行 UDP 失败。"
    info "已通过 ufw 放行 TCP/UDP ${PORT}。"
    return 0
  fi
  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -q running; then
    firewall-cmd --permanent --add-port="${PORT}/tcp" || die "firewalld 放行 TCP 失败。"
    firewall-cmd --permanent --add-port="${PORT}/udp" || die "firewalld 放行 UDP 失败。"
    firewall-cmd --reload || true
    info "已通过 firewalld 放行 TCP/UDP ${PORT}。"
    return 0
  fi
  warn "未检测到已启用的 ufw 或 firewalld。本脚本不会擅自改 iptables/nft 默认策略。请自行放行 TCP/UDP ${PORT}，并检查云防火墙/安全组。"
}

maybe_open_new_ports() {
  local mode
  if [[ -n "${OPEN_PORT_MODE}" ]]; then
    mode="$OPEN_PORT_MODE"
  elif [[ -t 0 ]]; then
    mode='ask'
  else
    mode='no'
  fi
  info "如需本机放行新端口，只会新增 TCP/UDP ${PORT} 规则，不会删除旧端口 TCP/UDP ${OLD_PORT} 的规则（可能仍被其他服务使用）。云安全组请自行放行新端口；若经中转，还要同步中转的后端端口映射，并更新客户端链接。"
  case "$mode" in
    no|NO|0)
      info "已跳过本机防火墙写入。请自行放行 TCP/UDP ${PORT}，并检查云安全组。"
      return 0
      ;;
    yes|YES|1)
      ;;
    ask|ASK)
      if confirm_firewall "是否仅新增放行本机 TCP ${PORT} 与 UDP ${PORT}（不删旧规则、不改默认策略和 SSH）？"; then
        mode='yes'
      else
        info "已跳过本机端口放行。请记得在云安全组放行 TCP/UDP ${PORT}。"
        return 0
      fi
      ;;
    *) die "SS_NODE_OPEN_PORT 只能是 yes、no 或 ask。" ;;
  esac
  if [[ $SANDBOX -eq 1 ]]; then
    info "沙箱模式：不修改防火墙。"
    return 0
  fi
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
    ufw allow "${PORT}/tcp" comment 'ss-node' || die "ufw 放行 TCP 失败。"
    ufw allow "${PORT}/udp" comment 'ss-node' || die "ufw 放行 UDP 失败。"
    info "已通过 ufw 新增 TCP/UDP ${PORT}。未删除旧端口规则。"
    return 0
  fi
  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -q running; then
    firewall-cmd --permanent --add-port="${PORT}/tcp" || die "firewalld 放行 TCP 失败。"
    firewall-cmd --permanent --add-port="${PORT}/udp" || die "firewalld 放行 UDP 失败。"
    firewall-cmd --reload || true
    info "已通过 firewalld 新增 TCP/UDP ${PORT}。未删除旧端口规则。"
    return 0
  fi
  warn "未检测到已启用的 ufw 或 firewalld。本脚本不会擅自改 iptables/nft。请自行放行 TCP/UDP ${PORT}，并检查云防火墙/安全组。"
}

start_service() {
  systemctl enable "$UNIT_NAME"
  if ! systemctl start "$UNIT_NAME"; then
    err "服务启动失败。"
    systemctl status "$UNIT_NAME" --no-pager -l || true
    journalctl -u "$UNIT_NAME" -n 80 --no-pager || true
    rollback_install
    die "已回滚到安装前状态（若为首次安装则已禁用并移除新单元）。配置与密码通常仍保留，可修正后重跑，不必删除安装目录。"
  fi
  SERVICE_STARTED_THIS_RUN=1
  if ! systemctl is-active --quiet "$UNIT_NAME"; then
    rollback_install
    die "服务未能保持运行，已回滚。"
  fi
  info "服务已启用并启动：${UNIT_NAME}"
}

restart_our_service_after_port_change() {
  local was_active="${PREV_UNIT_ACTIVE}"
  if ! systemctl restart "$UNIT_NAME"; then
    err "换端口后服务重启失败，不会停止其他服务。正在恢复旧配置。"
    systemctl status "$UNIT_NAME" --no-pager -l || true
    journalctl -u "$UNIT_NAME" -n 80 --no-pager || true
    rollback_install
    if [[ "$was_active" == "active" ]]; then
      systemctl start "$UNIT_NAME" >/dev/null 2>&1 || true
    fi
    die "已恢复原来的端口、配置和客户端链接。"
  fi
  SERVICE_STARTED_THIS_RUN=1
  if ! systemctl is-active --quiet "$UNIT_NAME"; then
    rollback_install
    if [[ "$was_active" == "active" ]]; then
      systemctl start "$UNIT_NAME" >/dev/null 2>&1 || true
    fi
    die "服务未能在新端口保持运行，已恢复原来的端口、配置和客户端链接。"
  fi
  info "服务 ${UNIT_NAME} 已在 TCP/UDP ${PORT} 上运行。密码、算法和名称未改动。"
}


choose_listen() {
  if ipv6_enabled; then
    LISTEN='::'
  else
    LISTEN='0.0.0.0'
  fi
}

detect_public_address() {
  local v4='' v6=''
  local svc
  if [[ -n "${SS_NODE_ADDRESS:-}" ]]; then
    SERVER_ADDRESS="$SS_NODE_ADDRESS"
    return
  fi
  for svc in \
      'https://api.ipify.org' \
      'https://ifconfig.me/ip' \
      'https://icanhazip.com'
  do
    if [[ -z "$v4" ]]; then
      v4="$(curl -4 -fsS --connect-timeout 5 --max-time 10 "$svc" 2>/dev/null | tr -d '[:space:]' || true)"
      [[ "$v4" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || v4=''
    fi
    if ipv6_enabled && [[ -z "$v6" ]]; then
      v6="$(curl -6 -fsS --connect-timeout 5 --max-time 10 "$svc" 2>/dev/null | tr -d '[:space:]' || true)"
      [[ "$v6" == *:* ]] || v6=''
    fi
    [[ -n "$v4" ]] && break
  done
  if [[ -n "$v4" ]]; then
    SERVER_ADDRESS="$v4"
    return
  fi
  if [[ -n "$v6" ]]; then
    SERVER_ADDRESS="$v6"
    return
  fi
  if [[ -t 0 && $ASSUME_YES -eq 0 ]]; then
    SERVER_ADDRESS="$(ask '未能自动检测本机公网地址，请输入写入落地分享链接的 IP 或域名')"
  else
    die "无法检测公网地址。请设置 SS_NODE_ADDRESS。"
  fi
  [[ -n "$SERVER_ADDRESS" ]] || die "服务器地址不能为空。"
}

prompt_share_address() {
  local raw="${SS_NODE_ADDRESS:-}"
  local saved="${1:-}"
  if [[ -n "$raw" ]]; then
    SERVER_ADDRESS="$raw"
    return
  fi
  if [[ -n "$saved" ]]; then
    SERVER_ADDRESS="$saved"
    info "重复安装保留落地地址：${SERVER_ADDRESS}。不会向公网重新查询或改写已保存的地址。"
    return
  fi
  detect_public_address
  if [[ $ASSUME_YES -eq 1 || ! -t 0 ]]; then
    info "分享链接将使用本机落地地址：${SERVER_ADDRESS}。这不是中转入口地址。"
    return
  fi
  raw="$(ask "写入本机落地分享链接的地址（直接回车使用 ${SERVER_ADDRESS}。若客户端要连前面的中转，请改填中转入口，不要当成同一条链接）" "$SERVER_ADDRESS")"
  raw="$(printf '%s' "$raw" | awk '{$1=$1; print}')"
  [[ -n "$raw" ]] || die "服务器地址不能为空。"
  SERVER_ADDRESS="$raw"
}

load_saved_identity() {
  # 仅在确认已有完整身份后再写入全局变量。首次安装时若先清空 PORT 等字段，
  # 会丢掉 prompt_inputs 已采集的端口/名称/算法/地址，导致随后 write_state 对空端口 int('') 失败。
  if ! our_install_exists; then
    return 1
  fi
  local remark port method password listen address
  remark="$(json_get "$STATE_FILE" remark)"
  port="$(json_get "$STATE_FILE" port)"
  method="$(json_get "$STATE_FILE" method)"
  password="$(json_get "$STATE_FILE" password)"
  listen="$(json_get "$STATE_FILE" listen)"
  address="$(json_get "$STATE_FILE" address)"
  [[ -n "$remark" && -n "$port" && -n "$method" && -n "$password" ]] || die "已有 state.json 不完整，已中止以免覆盖密码。请人工检查 ${STATE_FILE}。"
  method="$(canonical_method "$method")" || die "已保存的加密方式不受支持，已中止，不会覆盖密码。"
  validate_password_for_method "$method" "$password" || die "已保存的密码与加密方式不匹配，已中止，不会重新生成并覆盖。"
  REMARK="$remark"
  PORT="$port"
  METHOD="$method"
  PASSWORD="$password"
  LISTEN="$listen"
  SERVER_ADDRESS="$address"
  return 0
}

load_or_create_identity() {
  if load_saved_identity; then
    info "检测到已有本脚本安装，将保留密码和加密方式。"
    return 0
  fi
  info "首次安装：生成随机密码（按所选加密方式使用正确格式与长度）。"
  PASSWORD="$(generate_password "$METHOD")"
  validate_password_for_method "$METHOD" "$PASSWORD" || die "生成的密码未通过校验。"
}

prompt_method() {
  local raw="${SS_NODE_METHOD:-}"
  local saved="${1:-}"
  # 已有节点：重跑安装必须保留原算法。仅下载并再跑一次安装不会迁移到新的默认值。
  if [[ -n "$saved" ]]; then
    METHOD="$(canonical_method "$saved")" || die "已保存的加密方式无效。"
    if [[ -n "$raw" ]]; then
      local want=''
      want="$(canonical_method "$raw")" || die "不支持的加密方式：${raw}。不支持 none/plain 或流密码。"
      if [[ "$want" != "$METHOD" ]]; then
        warn "已安装节点的加密方式是 ${METHOD}。重新运行安装不会改算法（也就不会自动改成默认的 ${DEFAULT_METHOD}）。如需迁移并保留密码、端口、地址和名称，请使用：sudo bash ${SCRIPT_NAME} --change-method ${want}"
      else
        info "重复安装保留加密方式：${METHOD}。仅重新下载并再跑一次安装不会改算法。如需迁移并保留密码、端口、地址和名称，请使用：sudo bash ${SCRIPT_NAME} --change-method ${DEFAULT_METHOD}"
      fi
    else
      info "重复安装保留加密方式：${METHOD}。仅重新下载并再跑一次安装不会改算法。如需迁移并保留密码、端口、地址和名称，请使用：sudo bash ${SCRIPT_NAME} --change-method ${DEFAULT_METHOD}"
    fi
    return 0
  fi
  if [[ -n "$raw" ]]; then
    METHOD="$(canonical_method "$raw")" || die "不支持的加密方式：${raw}。可选：${METHOD_AES256}（默认）、${METHOD_AES128}、${METHOD_CHACHA}、${METHOD_SS2022}。不支持 none/plain 或流密码。"
    return 0
  fi
  if [[ $ASSUME_YES -eq 1 ]]; then
    METHOD="$DEFAULT_METHOD"
    info "未指定加密方式，新安装使用默认 ${METHOD}（传统 AEAD，便于与常见 3x-ui 出站选项对齐）。"
    return 0
  fi
  if [[ ! -t 0 ]]; then
    die "非交互模式请设置 SS_NODE_METHOD，或使用 --yes 采用默认 ${DEFAULT_METHOD}。"
  fi
  cat >&2 <<EOF
请选择加密方式（输入编号，直接回车为 1）：
  1) ${METHOD_AES256}            [默认] 传统 AEAD，与常见 3x-ui 出站选项一致
  2) ${METHOD_AES128}            传统 AEAD
  3) ${METHOD_CHACHA}   传统 AEAD，无 AES-NI 的机器往往更合适
  4) ${METHOD_SS2022}    Shadowsocks 2022，重放保护更完整，但中转必须明确支持
说明：官方文档更推荐 SS2022；默认仍用传统 AEAD。会识别或终止 SS 的中转（例如 3x-ui 出站）必须与落地算法一致。
      已有节点若要改算法，请用 --change-method，不要指望重新跑安装。
      不支持 none/plain，也不提供已淘汰的流密码。
EOF
  raw="$(ask '加密方式' '1')"
  case "$raw" in
    1|"$METHOD_AES256"|"") METHOD="$METHOD_AES256" ;;
    2|"$METHOD_AES128") METHOD="$METHOD_AES128" ;;
    3|"$METHOD_CHACHA"|chacha20-poly1305) METHOD="$METHOD_CHACHA" ;;
    4|"$METHOD_SS2022") METHOD="$METHOD_SS2022" ;;
    *) die "无效选择：${raw}" ;;
  esac
}

prompt_inputs() {
  local raw_name raw_port saved_remark saved_port saved_method saved_address
  saved_remark=''
  saved_port=''
  saved_method=''
  saved_address=''
  if our_install_exists; then
    saved_remark="$(json_get "$STATE_FILE" remark || true)"
    saved_port="$(json_get "$STATE_FILE" port || true)"
    saved_method="$(json_get "$STATE_FILE" method || true)"
    saved_address="$(json_get "$STATE_FILE" address || true)"
  fi

  raw_name="${SS_NODE_REMARK:-${SS_NODE_NAME:-}}"
  if [[ -z "$raw_name" ]]; then
    if [[ -n "$saved_remark" && $ASSUME_YES -eq 1 ]]; then
      raw_name="$saved_remark"
      info "重复安装保留节点名称：${raw_name}"
    elif [[ $ASSUME_YES -eq 1 ]]; then
      die "非交互模式需要设置 SS_NODE_REMARK（节点名称按你的备注原样使用，不会强制加 SS- 前缀）。"
    elif [[ ! -t 0 ]]; then
      die "没有终端可询问节点名称。请设置 SS_NODE_REMARK。"
    elif [[ -n "$saved_remark" ]]; then
      raw_name="$(ask "节点名称（直接回车保留 ${saved_remark}）" "$saved_remark")"
    else
      raw_name="$(ask '节点名称（按你的备注原样使用，不会自动加 SS- 前缀）')"
    fi
  fi
  REMARK="$(normalize_remark "$raw_name")" || die "节点名称无效，不能为空，也不能包含换行（最长 128 字符）。"

  if [[ -n "${SS_NODE_PORT:-}" ]]; then
    raw_port="${SS_NODE_PORT}"
  elif [[ $ASSUME_YES -eq 1 ]]; then
    raw_port="$(resolve_listen_port "" "$saved_port")"
    if [[ -z "$saved_port" ]]; then
      info "未指定端口，使用推荐的 ${DEFAULT_PORT}（同时监听 TCP 和 UDP）。若该端口已被 XHTTP/HY2 或其他服务占用，将会报错而不会停止它们。"
    fi
  else
    if [[ ! -t 0 ]]; then
      die "没有终端可询问端口。请设置 SS_NODE_PORT。"
    fi
    if [[ -n "$saved_port" ]]; then
      raw_port="$(ask "监听端口（TCP 与 UDP 同一端口，直接回车保留 ${saved_port}）" "$saved_port")"
    else
      raw_port="$(ask "监听端口（TCP 与 UDP 同一端口；推荐 ${DEFAULT_PORT}。若 ${DEFAULT_PORT} 已被 XHTTP/HY2 占用请换端口，本脚本不会停止已有服务）" "$DEFAULT_PORT")"
    fi
    raw_port="$(resolve_listen_port "$raw_port" "$saved_port")"
  fi
  valid_port "$raw_port" || die "端口无效：${raw_port:-空}"
  PORT="$raw_port"
  assert_ss_port_free "$PORT"

  prompt_method "$saved_method"
  prompt_share_address "$saved_address"
}

write_link_file() {
  local uri
  uri="$(with_secrets_quiet build_share_uri)"
  printf '%s\n' "$uri" | write_secret_file "$LINK_FILE" 0600
  if [[ $SKIP_SYSTEMD -eq 0 ]]; then
    chown root:root "$LINK_FILE" 2>/dev/null || true
  fi
  info "本机落地分享链接已写入受限文件：${LINK_FILE}（请当凭据保管，不要发到聊天或日志）。落地链接与中转入口链接不是同一条。"
}

# 把地址分类为 IP 或域名；空值报错，不向公网查询、不编造。
format_server_address_line() {
  python3 - "$1" <<'PYCODE'
import ipaddress,sys
raw=(sys.argv[1] or "").strip()
if not raw:
    sys.stderr.write("服务器地址为空，拒绝编造或向公网查询。\n")
    sys.exit(2)
core=raw[1:-1] if raw.startswith("[") and raw.endswith("]") else raw
try:
    ipaddress.ip_address(core)
    print("服务器地址（IP）：%s" % raw)
except ValueError:
    print("服务器地址（域名）：%s" % raw)
PYCODE
}

# 第一屏连接参数卡：地址、端口、明文密码、算法、协议、传输、安全、UoT、完整链接。
print_connection_card() {
  local uri line_addr xtrace_was=0
  case "$-" in *x*) xtrace_was=1; set +x ;; esac
  if [[ -z "${SERVER_ADDRESS:-}" ]]; then
    [[ $xtrace_was -eq 1 ]] && set -x
    die "服务器地址为空，无法显示连接信息。不会向公网查询或编造地址。"
  fi
  line_addr="$(format_server_address_line "$SERVER_ADDRESS")" || {
    [[ $xtrace_was -eq 1 ]] && set -x
    die "服务器地址无效，无法显示连接信息。"
  }
  uri="$(with_secrets_quiet build_share_uri)"
  cat <<EOF
${line_addr}
端口：${PORT}
密码：${PASSWORD}
加密方式：${METHOD}
协议：Shadowsocks
传输：RAW（普通 TCP 流；入站同时监听 TCP 与 UDP）
安全：无（未启用 TLS。这不等于未加密，流量由 Shadowsocks 自身加密。）
UDP over TCP（UoT）：关闭
完整分享链接：
${uri}
EOF
  if [[ $xtrace_was -eq 1 ]]; then
    set -x
  fi
  return 0
}

save_identity_files() {
  if [[ -z "${REMARK:-}" || -z "${PORT:-}" || -z "${METHOD:-}" || -z "${PASSWORD:-}" || -z "${LISTEN:-}" || -z "${SERVER_ADDRESS:-}" ]]; then
    die "内部错误：写入配置前缺少名称、端口、加密方式、密码、监听或地址（端口=${PORT:-空}）。已中止，以免写出坏配置或覆盖已有身份。"
  fi
  valid_port "$PORT" || die "内部错误：写入配置前端口无效：${PORT:-空}"
  mkdir -p "$ETC_DIR"
  chmod 0750 "$ETC_DIR"
  write_state
  write_config
}

print_udp_caveat() {
  info "本节点会在同一端口同时监听原生 SS 的 TCP 与 UDP。这不等于只开 TCP 就能转发 UDP：UDP 还需要中转和客户端全链支持原生 SS UDP。许多仅做 TCP 四层转发的中转无法传递 UDP。"
}

# 使用全局目录变量，避免 EXIT 陷阱在函数返回、local 变量已释放后触发 set -u。
cleanup_install_tmp() {
  local dir="${SS_TMP_WORK:-}"
  SS_TMP_WORK=''
  if [[ -n "$dir" && -d "$dir" ]]; then
    rm -rf "$dir"
  fi
}

run_install() {
  detect_asset
  init_paths
  if [[ $SANDBOX -eq 0 && $SKIP_SYSTEMD -eq 0 ]]; then
    [[ "$(id -u)" == "0" ]] || die "安装需要 root（请使用 sudo）。自检请用 --self-test。"
    os_supported || die "仅支持 Debian 与 Ubuntu。当前系统：$(os_id || echo 未知)。"
    have_systemd || die "需要 systemd（检测到 /run/systemd/system 不存在）。"
    ensure_dependencies
  else
    need_cmd bash curl unzip sha256sum python3
    command -v ss >/dev/null 2>&1 || command -v lsof >/dev/null 2>&1 || die "需要 ss 或 lsof 以检查端口占用。"
  fi
  preflight_conflicts
  prompt_inputs
  choose_listen
  [[ -n "$LISTEN" ]] || choose_listen

  local bin
  cleanup_install_tmp
  SS_TMP_WORK="$(mktemp -d "${TMPDIR:-/tmp}/ss-node-work.XXXXXX")"
  trap 'cleanup_install_tmp' EXIT

  bin="$(obtain_verified_binary "$SS_TMP_WORK")"
  load_or_create_identity

  mkdir -p "$ETC_DIR"
  prepare_rollback_snapshots
  save_identity_files
  if ! validate_config "$bin" "$CONFIG_FILE"; then
    rollback_install
    die "配置校验失败，已回滚。"
  fi

  install_binaries_from_work "$bin"
  if [[ $SKIP_SYSTEMD -eq 1 ]]; then
    fix_permissions
    write_link_file
    echo
    print_connection_card
    echo
    print_udp_caveat
    info "沙箱/跳过 systemd 模式已完成。配置在 ${CONFIG_FILE}，链接在 ${LINK_FILE}。未安装系统服务，未开端口，未改防火墙。"
    trap - EXIT
    cleanup_install_tmp
    return 0
  fi

  ensure_sysuser
  fix_permissions
  assert_runtime_access
  write_unit
  maybe_open_ports
  start_service
  write_link_file
  echo
  print_connection_card
  echo
  print_udp_caveat
  info "安装完成。Xray 版本固定为 ${XRAY_VERSION}。服务 ${UNIT_NAME} 与 XHTTP 服务相互独立。"
  info "本机配置：${CONFIG_FILE}"
  info "分享链接文件：${LINK_FILE}"
  info "云厂商安全组 / 网络 ACL 需要你自行放行 ${PORT}/tcp 与 ${PORT}/udp。本脚本无法代为修改。若经中转，请同步中转后端映射。"
  trap - EXIT
  cleanup_install_tmp
}

