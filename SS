    die "只允许在传统 AEAD（${METHOD_AES256}、${METHOD_AES128}、${METHOD_CHACHA}）之间切换并保留原密码。已拒绝 ${old_method} -> ${METHOD}。"
  fi
  validate_password_for_method "$METHOD" "$PASSWORD" || die "现有密码不符合 ${METHOD} 的格式要求，已中止，不会改写配置。"
  info "将把加密方式从 ${old_method} 改为 ${METHOD}。会保留密码、端口、地址和节点名称，不会重新生成密码，也不会改端口或下载/升级二进制。"
  mkdir -p "$ETC_DIR"
