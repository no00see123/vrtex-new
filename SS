#!/usr/bin/env bash
# 独立部署 Shadowsocks 落地节点（不安装 3x-ui 面板，不并入已有 XHTTP 配置）。
# 固定官方版本：Xray-core v26.6.27（官方预发布，不会静默改用最新版）。
# 传输为原生 SS RAW（普通 TCP 流 + 可选原生 UDP 监听），不套 WS / XHTTP / TLS，不申请 ACME。
# 仅本脚本被授权制作；不会改 SSH、全局防火墙策略，也不会部署到未被指定的机器。
set -euo pipefail

# ---------------------------------------------------------------------------
# 固定版本与官方校验和（来自官方 .dgst / GitHub Releases，不是供应链认证）
# ---------------------------------------------------------------------------
readonly XRAY_VERSION='v26.6.27'
readonly XRAY_RELEASE_TAG='v26.6.27'
readonly GITHUB_REPO='XTLS/Xray-core'
readonly DEFAULT_RELEASE_BASE="https://github.com/${GITHUB_REPO}/releases/download/${XRAY_RELEASE_TAG}"

# 官方 zip 的 SHA2-256（与 XHTTP 脚本钉死值相同；来自该版本 .dgst）
readonly PINNED_SHA256_LINUX_64='b3e5902d06d6282fe53cfa2fc426058b9aeaa429b2c812e20887cd47f26d08bf'
readonly PINNED_SHA256_LINUX_ARM64='13a251379bea366c2cf10363ad71e75734193d401f26f518bf0c25e5c8f8c931'
# 解压后官方 xray 二进制的 SHA256（用于安全复用已校验的同版本文件，无需再下 zip）
readonly PINNED_SHA256_BIN_LINUX_64='8ef87ac07f95617e094b8e9302ea3e0c2d0edaa7045d57b455fdee28b3c9e41e'
readonly PINNED_SHA256_BIN_LINUX_ARM64='53ad04b1ddcba6f4ff8834b3db2e9a596456441259cea3e4f03f86cd39e22884'

readonly SCRIPT_NAME='install-ss-node.sh'
readonly SCRIPT_VERSION='1.1.0'
readonly UNIT_NAME='ss-node.service'
readonly DEFAULT_PREFIX='/opt/ss-node'
readonly SYSUSER='ss-node'
readonly XHTTP_PREFIX_DEFAULT='/opt/xray-node'
readonly XHTTP_UNIT_NAME='xray-node.service'
readonly DEFAULT_METHOD='aes-256-gcm'
readonly DEFAULT_PORT='443'
readonly SS_NETWORK='tcp,udp'

# 明确默认 + 少量安全可选项。不提供 none/plain，也不提供已淘汰流密码。
readonly METHOD_AES128='aes-128-gcm'
readonly METHOD_AES256='aes-256-gcm'
readonly METHOD_CHACHA='chacha20-ietf-poly1305'
readonly METHOD_SS2022='2022-blake3-aes-128-gcm'

# ---------------------------------------------------------------------------
# 全局状态
# ---------------------------------------------------------------------------
PREFIX="${SS_NODE_PREFIX:-$DEFAULT_PREFIX}"
RELEASE_BASE="${SS_NODE_RELEASE_BASE:-$DEFAULT_RELEASE_BASE}"
XHTTP_PREFIX="${SS_NODE_XHTTP_PREFIX:-$XHTTP_PREFIX_DEFAULT}"
SANDBOX=0
SKIP_SYSTEMD=0
ASSUME_YES=0
OPEN_PORT_MODE="${SS_NODE_OPEN_PORT:-}"
INSTALL_DEPS_MODE="${SS_NODE_INSTALL_DEPS:-}"

BIN_DIR=''
ETC_DIR=''
LOG_DIR=''
STATE_FILE=''
CONFIG_FILE=''
LINK_FILE=''
UNIT_PATH='/etc/systemd/system/ss-node.service'

ASSET_ZIP=''
ASSET_DGST=''
PINNED_SHA256=''
PINNED_SHA256_BIN=''

REMARK=''
PORT=''
OLD_PORT=''
LISTEN=''
SERVER_ADDRESS=''
METHOD=''
PASSWORD=''
BIN_SOURCE_NOTE=''
REQUESTED_PORT=''
REQUESTED_METHOD=''

PREV_CONFIG_BAK=''
PREV_STATE_BAK=''
PREV_LINK_BAK=''
PREV_UNIT_BAK=''
PREV_UNIT_ENABLED=''
PREV_UNIT_ACTIVE=''
NEW_UNIT_WRITTEN=0
SERVICE_STARTED_THIS_RUN=0
SS_TMP_WORK=''

# ---------------------------------------------------------------------------
# 日志（默认不打印密码或完整分享链接；终端按需输出除外）
# ---------------------------------------------------------------------------
is_tty() { [[ -t 1 ]]; }

log()  { printf '%s\n' "$*" >&2; }
info() { printf '[信息] %s\n' "$*" >&2; }
warn() { printf '[警告] %s\n' "$*" >&2; }
err()  { printf '[错误] %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

with_secrets_quiet() {
  local xtrace_was=0
  case "$-" in *x*) xtrace_was=1; set +x ;; esac
  "$@"
  local rc=$?
  if [[ $xtrace_was -eq 1 ]]; then set -x; fi
  return "$rc"
}

usage() {
  cat <<EOF
${SCRIPT_NAME} ${SCRIPT_VERSION}
在 Debian / Ubuntu（systemd，amd64 或 arm64）上安装固定版本官方 Xray-core ${XRAY_VERSION}，
部署单节点 Shadowsocks 落地：原生 RAW（普通 TCP 流），同时监听 TCP 和 UDP，不套 WS、
XHTTP 或 TLS，不申请域名证书。认证与加密由 SS 自身提供。

本脚本使用独立目录与独立 systemd 服务（${UNIT_NAME}，默认 ${DEFAULT_PREFIX}），
不会把 SS 入站并入已有 XHTTP（${XHTTP_UNIT_NAME}）配置，也不会停止其他节点服务。
若本机已有校验通过的同版本官方 Xray 二进制，会复制到本脚本目录再用；同版本不等于同一进程。

用法:
  sudo bash ${SCRIPT_NAME}                 交互安装（需 root）
  sudo bash ${SCRIPT_NAME} --yes           非交互：需已通过环境变量提供备注；端口未指定时用推荐的 443
  sudo bash ${SCRIPT_NAME} --change-port [端口]
                                           给已安装节点更换端口（保留密码、算法和名称；无端口则交互询问）
  sudo bash ${SCRIPT_NAME} --change-method [算法]
                                           给已安装节点更换加密方式（保留密码、端口、地址和名称）
  sudo bash ${SCRIPT_NAME} --info          只读显示地址、端口、明文密码、算法与完整导入链接（需 root；不安装、不改文件、不重启）
  bash ${SCRIPT_NAME} --self-test          本地自检（不安装系统服务、不开端口、不改防火墙）
  bash ${SCRIPT_NAME} --help

把脚本放到 GitHub 后，在目标 VPS 上可用：
  curl -fL --retry 3 'https://raw.githubusercontent.com/no00see123/vrtex-new/refs/heads/main/SS' -o install-ss-node.sh && bash install-ss-node.sh

仅重新下载并再跑一次安装，不会把已有节点从 aes-128-gcm 改成 aes-256-gcm；已有落地请用 --change-method。

新机器若缺依赖，可先以 root 一次补齐（不要和外层 curl 写在同一条强制检查里）：
  apt-get update && apt-get install -y curl ca-certificates python3 unzip iproute2

端口由你填写或确认，不会随机生成。新安装默认推荐 ${DEFAULT_PORT}（TCP 与 UDP 同一端口）。
若 ${DEFAULT_PORT}/tcp 已被 XHTTP 占用、或 ${DEFAULT_PORT}/udp 已被 HY2 占用，请换端口；
本脚本不会为了让出端口而停止已有服务。

常用环境变量:
  SS_NODE_REMARK            节点名称（按你的备注原样使用，不会强制加 SS- 前缀）
  SS_NODE_NAME              同上（别名）
  SS_NODE_PORT              监听端口（同时用于 TCP 和 UDP）
  SS_NODE_ADDRESS           写入本机落地分享链接的地址（IPv4 / IPv6 / 域名）
  SS_NODE_METHOD            新装加密：${METHOD_AES256}（默认）、${METHOD_AES128}、${METHOD_CHACHA}、${METHOD_SS2022}；重跑已有安装不会用它来改算法
  SS_NODE_OPEN_PORT=yes|no|ask     是否放行本机最小 TCP+UDP 端口（默认：有终端则 ask，否则 no）
  SS_NODE_INSTALL_DEPS=yes|no|ask  缺失依赖时是否 apt 安装（默认同上；未确认则不装）
  SS_NODE_XRAY_BIN          额外指定一个已有的官方 ${XRAY_VERSION} 二进制（仍校验钉死哈希后再复制）
  SS_NODE_RELEASE_BASE      官方 release 下载前缀（仍校验官方校验和；默认 GitHub）
  SS_NODE_PREFIX            安装目录（默认 ${DEFAULT_PREFIX}）

默认输出的是本机落地 SS 链接。若前面还有中转，客户端应使用中转入口的地址和端口；
落地原始链接与前端中转链接不是同一条，本脚本无法自动知道中转入口。

${XRAY_VERSION} 是官方预发布（prerelease），本脚本有意钉死该版本，不会自动升级。
官方校验只核对本版本附带的 .dgst 哈希与钉死的二进制哈希；这不是签名或供应链认证。
EOF
}

need_cmd() {
  local c
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || die "缺少命令：$c。请先安装后再运行。"
  done
}

os_id() {
  local id=''
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    id="$(. /etc/os-release && printf '%s' "${ID:-}")"
  fi
  printf '%s' "$id"
}

os_supported() {
  case "$(os_id)" in
    debian|ubuntu) return 0 ;;
    *) return 1 ;;
  esac
}

have_systemd() {
  command -v systemctl >/dev/null 2>&1 || return 1
  [[ -d /run/systemd/system ]] || return 1
}

detect_asset() {
  local m
  m="$(uname -m)"
  case "$m" in
    x86_64|amd64)
      ASSET_ZIP='Xray-linux-64.zip'
      PINNED_SHA256="$PINNED_SHA256_LINUX_64"
      PINNED_SHA256_BIN="$PINNED_SHA256_BIN_LINUX_64"
      ;;
    aarch64|arm64)
      ASSET_ZIP='Xray-linux-arm64-v8a.zip'
      PINNED_SHA256="$PINNED_SHA256_LINUX_ARM64"
      PINNED_SHA256_BIN="$PINNED_SHA256_BIN_LINUX_ARM64"
      ;;
    *)
      die "不支持的架构：$m。仅支持 amd64（x86_64）与 arm64（aarch64）。"
      ;;
  esac
  ASSET_DGST="${ASSET_ZIP}.dgst"
}

init_paths() {
  BIN_DIR="${PREFIX}/bin"
  ETC_DIR="${PREFIX}/etc"
  LOG_DIR="${PREFIX}/log"
  STATE_FILE="${ETC_DIR}/state.json"
  CONFIG_FILE="${ETC_DIR}/config.json"
  LINK_FILE="${ETC_DIR}/client-link.txt"
  if [[ $SANDBOX -eq 1 ]]; then
    UNIT_PATH="${PREFIX}/ss-node.service"
  fi
}

valid_port() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  ((10#$p >= 1 && 10#$p <= 65535))
}

# 输入优先；否则保留已保存端口；新装未指定时用推荐的 443。不会随机生成。
resolve_listen_port() {
  local input="$1" saved="$2"
  if [[ -n "$input" ]]; then
    printf '%s' "$input"
    return 0
  fi
  if [[ -n "$saved" ]]; then
    printf '%s' "$saved"
    return 0
  fi
  printf '%s' "$DEFAULT_PORT"
}

normalize_remark() {
  python3 - "$1" <<'PYCODE'
import sys
raw=(sys.argv[1] or "").replace("\r","").replace("\n","").strip()
if not raw:
    sys.exit(2)
if len(raw) > 128:
    sys.exit(3)
print(raw)
PYCODE
}

is_ss2022_method() {
  local m="$1"
  [[ "$m" == 2022-blake3-* ]]
}

is_classic_aead_method() {
  case "$1" in
    aes-128-gcm|aes-256-gcm|chacha20-ietf-poly1305) return 0 ;;
    *) return 1 ;;
  esac
}

canonical_method() {
  python3 - "$1" <<'PYCODE'
import sys
raw=(sys.argv[1] or "").strip().lower()
aliases={
  "aes-128-gcm":"aes-128-gcm",
  "aes-256-gcm":"aes-256-gcm",
  "chacha20-ietf-poly1305":"chacha20-ietf-poly1305",
  "chacha20-poly1305":"chacha20-ietf-poly1305",
  "2022-blake3-aes-128-gcm":"2022-blake3-aes-128-gcm",
}
# 明确拒绝，即使该版 Xray 可能仍接受 none/plain
blocked={"none","plain","dummy","rc4-md5","aes-256-cfb","aes-128-cfb","aes-128-ctr","aes-256-ctr","chacha20","chacha20-ietf"}
if raw in blocked:
    sys.exit(4)
if raw not in aliases:
    sys.exit(3)
print(aliases[raw])
PYCODE
}

ss2022_key_bytes() {
  case "$1" in
    2022-blake3-aes-128-gcm) printf '16' ;;
    2022-blake3-aes-256-gcm|2022-blake3-chacha20-poly1305) printf '32' ;;
    *) printf '0' ;;
  esac
}

json_get() {
  local file="$1" key="$2"
  python3 - "$file" "$key" <<'PY'
import json,sys
path,key=sys.argv[1],sys.argv[2]
with open(path,encoding='utf-8') as f:
    data=json.load(f)
val=data.get(key,"")
if isinstance(val,list):
    print(",".join(str(x) for x in val))
elif val is None:
    print("")
else:
    print(val)
PY
}

format_host_for_uri() {
  local host="$1"
  if [[ "$host" == \[*\] ]]; then
    printf '%s' "$host"
    return
  fi
  if [[ "$host" == *:* ]]; then
    printf '[%s]' "$host"
    return
  fi
  printf '%s' "$host"
}

ipv6_enabled() {
  [[ -e /proc/net/if_inet6 ]] || return 1
  if [[ -r /proc/sys/net/ipv6/conf/all/disable_ipv6 ]]; then
    [[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6)" == "0" ]] || return 1
  fi
  return 0
}

sha256_of() {
  sha256sum "$1" | awk '{print $1}'
}

ask() {
  local prompt="$1" default="${2:-}"
  local ans
  if [[ -n "$default" ]]; then
    printf '%s [%s]: ' "$prompt" "$default" >&2
    read -r ans || true
    printf '%s' "${ans:-$default}"
  else
    printf '%s: ' "$prompt" >&2
    read -r ans || true
    printf '%s' "$ans"
  fi
}

confirm() {
  local prompt="$1"
  if [[ $ASSUME_YES -eq 1 ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    return 1
  fi
  local ans
  printf '%s [y/N] ' "$prompt" >&2
  read -r ans || return 1
  case "$ans" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

# 防火墙放行必须单独确认；--yes 不会自动改本机防火墙（除非 SS_NODE_OPEN_PORT=yes）。
confirm_firewall() {
  local prompt="$1"
  if [[ ! -t 0 ]]; then
    return 1
  fi
  local ans
  printf '%s [y/N] ' "$prompt" >&2
  read -r ans || return 1
  case "$ans" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

tcp_port_in_use() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -H -lnt "( sport = :${port} )" 2>/dev/null | grep -q . && return 0
    return 1
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 && return 0
  fi
  return 1
}

udp_port_in_use() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -H -lnu "( sport = :${port} )" 2>/dev/null | grep -q . && return 0
    return 1
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -iUDP:"$port" >/dev/null 2>&1 && return 0
  fi
  return 1
}

our_pid() {
  local pid
  if [[ $SKIP_SYSTEMD -eq 1 ]]; then
    return 1
  fi
  if have_systemd && systemctl show -p MainPID --value "$UNIT_NAME" >/dev/null 2>&1; then
    pid="$(systemctl show -p MainPID --value "$UNIT_NAME" 2>/dev/null || true)"
    if [[ -n "${pid:-}" && "$pid" != "0" ]]; then
      printf '%s' "$pid"
      return 0
    fi
  fi
  return 1
}

our_service_owns_proto_port() {
  local proto="$1" port="$2"
  local pid
  pid="$(our_pid 2>/dev/null || true)"
  [[ -n "${pid:-}" ]] || return 1
  if command -v ss >/dev/null 2>&1; then
    case "$proto" in
      tcp) ss -H -lntp "( sport = :${port} )" 2>/dev/null | grep -q "pid=${pid}," && return 0 ;;
      udp) ss -H -lnup "( sport = :${port} )" 2>/dev/null | grep -q "pid=${pid}," && return 0 ;;
    esac
  fi
  return 1
}

describe_listener() {
  local proto="$1" port="$2"
  local out=''
  if command -v ss >/dev/null 2>&1; then
    case "$proto" in
      tcp) out="$(ss -H -lntp "( sport = :${port} )" 2>/dev/null | head -n 2 | tr '\n' ' ' || true)" ;;
      udp) out="$(ss -H -lnup "( sport = :${port} )" 2>/dev/null | head -n 2 | tr '\n' ' ' || true)" ;;
    esac
  fi
  out="${out%"${out##*[![:space:]]}"}"
  if [[ -n "$out" ]]; then
    printf '%s' "$out"
  else
    printf '%s' "已被占用（未能解析进程名）"
  fi
}

# SS 需要同一端口上的 TCP 与 UDP 都可用（除非已由本脚本自己的服务占用）。
assert_ss_port_free() {
  local port="$1"
  local tcp_busy=0 udp_busy=0
  local reasons=()

  if [[ "$port" == "22" ]]; then
    die "拒绝使用 22 端口，以免与 SSH 冲突。"
  fi

  if tcp_port_in_use "$port"; then
    if ! our_service_owns_proto_port tcp "$port"; then
      tcp_busy=1
      reasons+=("TCP ${port}：$(describe_listener tcp "$port")")
    fi
  fi
  if udp_port_in_use "$port"; then
    if ! our_service_owns_proto_port udp "$port"; then
      udp_busy=1
      reasons+=("UDP ${port}：$(describe_listener udp "$port")")
    fi
  fi

  if [[ $tcp_busy -eq 0 && $udp_busy -eq 0 ]]; then
    return 0
  fi

  err "端口 ${port} 无法同时用于本 SS 节点的 TCP 与 UDP 监听。"
  local r
  for r in "${reasons[@]}"; do
    err "  $r"
  done
  if [[ $tcp_busy -eq 1 && $udp_busy -eq 0 ]]; then
    err "常见情况：TCP ${port} 可能已被 XHTTP / 其他 TCP 服务占用。UDP 即使空闲也不能只用一半。"
  elif [[ $tcp_busy -eq 0 && $udp_busy -eq 1 ]]; then
    err "常见情况：UDP ${port} 可能已被 HY2 / 其他 UDP 服务占用。TCP 即使空闲也不能只用一半。"
  fi
  die "本脚本不会停止已有服务来抢端口，请换一个端口，或自行处理冲突后再试。"
}

detect_3xui() {
  local found=0
  if have_systemd; then
    if systemctl list-unit-files 'x-ui.service' --no-legend 2>/dev/null | grep -q .; then
      found=1
    elif systemctl is-active --quiet x-ui.service 2>/dev/null; then
      found=1
    fi
  fi
  if [[ -d /usr/local/x-ui || -e /usr/local/bin/x-ui ]]; then
    found=1
  fi
  [[ $found -eq 1 ]]
}

detect_official_or_other_xray() {
  local hits=()
  if [[ -e /usr/local/bin/xray ]]; then
    hits+=('/usr/local/bin/xray')
  fi
  if have_systemd && systemctl list-unit-files 'xray.service' --no-legend 2>/dev/null | grep -q .; then
    hits+=('systemd:xray.service')
  fi
  if [[ -d /usr/local/etc/xray ]]; then
    hits+=('/usr/local/etc/xray')
  fi
  if [[ ${#hits[@]} -gt 0 ]]; then
    printf '%s' "${hits[*]}"
    return 0
  fi
  return 1
}

detect_xhttp_node() {
  [[ -e "${XHTTP_PREFIX}/bin/xray" || -e /etc/systemd/system/${XHTTP_UNIT_NAME} || -d "${XHTTP_PREFIX}" ]]
}

detect_other_ss() {
  local hits=()
  local unit
  if have_systemd; then
    for unit in shadowsocks-libev.service shadowsocks-rust.service shadowsocks.service ss-server.service; do
      if systemctl list-unit-files "$unit" --no-legend 2>/dev/null | grep -q .; then
        hits+=("systemd:${unit}")
      elif systemctl is-active --quiet "$unit" 2>/dev/null; then
        hits+=("active:${unit}")
      fi
    done
  fi
  if [[ ${#hits[@]} -gt 0 ]]; then
    printf '%s' "${hits[*]}"
    return 0
  fi
  return 1
}

our_install_exists() {
  [[ -s "$STATE_FILE" && -s "$CONFIG_FILE" ]]
}

preflight_conflicts() {
  if [[ "$PREFIX" == "$XHTTP_PREFIX" || "$PREFIX" == /opt/xray-node || "$PREFIX" == /usr/local/etc/xray ]]; then
    die "拒绝安装到 ${PREFIX}：这会与 XHTTP 或其他 Xray 安装目录重合。SS 必须使用独立目录（默认 ${DEFAULT_PREFIX}）。"
  fi
  if [[ "$UNIT_PATH" == /etc/systemd/system/xray.service || "$UNIT_PATH" == /etc/systemd/system/${XHTTP_UNIT_NAME} || "$UNIT_PATH" == /etc/systemd/system/hy2-node.service ]]; then
    die "拒绝覆盖已有节点或官方通用的 systemd 单元：$UNIT_PATH"
  fi
  if [[ -e /usr/local/bin/xray && -e "$BIN_DIR/xray" && "$BIN_DIR/xray" -ef /usr/local/bin/xray ]]; then
    die "安装路径与已有 /usr/local/bin/xray 重合，已拒绝覆盖。"
  fi
  if detect_3xui; then
    warn "检测到可能存在的 3x-ui。本脚本不会覆盖、停止或改写它，也不会向其写入 SS 入站。"
  fi
  local other
  if other="$(detect_official_or_other_xray)"; then
    warn "检测到已有 Xray 文件或 xray.service：${other}。本脚本安装到 ${PREFIX} 与 ${UNIT_NAME}，不会覆盖这些路径，也不会停止现有服务。"
  fi
  if detect_xhttp_node; then
    info "检测到本机可能已有 XHTTP 节点（${XHTTP_PREFIX} 或 ${XHTTP_UNIT_NAME}）。本脚本不会修改它的配置或服务，也不会把 SS 并入同一进程。"
  fi
  if other="$(detect_other_ss)"; then
    warn "检测到可能存在的其他 Shadowsocks 服务：${other}。若端口冲突只会报错，不会停止或删除它。"
  fi
}

debian_packages_for_missing() {
  local missing_cmds="$1"
  local pkgs=()
  [[ "$missing_cmds" == *"curl"* ]] && pkgs+=(curl)
  [[ "$missing_cmds" == *"python3"* ]] && pkgs+=(python3)
  [[ "$missing_cmds" == *"unzip"* ]] && pkgs+=(unzip)
  [[ "$missing_cmds" == *"sha256sum"* ]] && pkgs+=(coreutils)
  if ! command -v ss >/dev/null 2>&1 && ! command -v lsof >/dev/null 2>&1; then
    pkgs+=(iproute2)
  fi
  if [[ ! -e /etc/ssl/certs/ca-certificates.crt ]]; then
    pkgs+=(ca-certificates)
  fi
  if [[ ${#pkgs[@]} -eq 0 ]]; then
    return 0
  fi
  printf '%s\n' "${pkgs[@]}" | awk 'NF && !seen[$0]++'
}

ensure_dependencies() {
  local missing=() cmd
  for cmd in curl python3 sha256sum unzip; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  if ! command -v ss >/dev/null 2>&1 && ! command -v lsof >/dev/null 2>&1; then
    missing+=("ss或lsof")
  fi
  if [[ ${#missing[@]} -eq 0 ]]; then
    if [[ ! -e /etc/ssl/certs/ca-certificates.crt ]]; then
      missing+=("ca-certificates")
    else
      return 0
    fi
  fi
  err "缺少命令或证书包：${missing[*]}。"
  local pkgs
  pkgs="$(debian_packages_for_missing "${missing[*]}")"
  if [[ -z "$pkgs" ]]; then
    die "请先安装缺失命令后再运行。"
  fi
  local pkg_line
  pkg_line="$(printf '%s' "$pkgs" | tr '\n' ' ')"
  info "可一次补齐（Debian/Ubuntu）：apt-get update && apt-get install -y ${pkg_line}"
  local mode="${INSTALL_DEPS_MODE}"
  if [[ -z "$mode" ]]; then
    if [[ $ASSUME_YES -eq 1 ]]; then
      mode='yes'
    elif [[ -t 0 ]]; then
      mode='ask'
    else
      mode='no'
    fi
  fi
  case "$mode" in
    no|NO|0)
      die "未确认安装依赖，已中止。请先执行上面的 apt 命令后重试。"
      ;;
    yes|YES|1)
      ;;
    ask|ASK)
      if confirm "是否现在用 apt 安装这些依赖（${pkg_line}）？未确认则不会安装。"; then
        mode='yes'
      else
        die "未确认安装依赖，已中止。请先执行：apt-get update && apt-get install -y ${pkg_line}"
      fi
      ;;
    *) die "SS_NODE_INSTALL_DEPS 只能是 yes、no 或 ask。" ;;
  esac
  if [[ "$(id -u)" != "0" ]]; then
    die "安装依赖需要 root。请先手动执行：apt-get update && apt-get install -y ${pkg_line}"
  fi
  if [[ $SANDBOX -eq 1 || $SKIP_SYSTEMD -eq 1 ]]; then
    die "当前为沙箱/自检模式，不会在本机 apt 安装软件包。请换到目标 VPS 或先自行安装依赖。"
  fi
  apt-get update
  # shellcheck disable=SC2086
  apt-get install -y $pkgs
  for cmd in curl python3 sha256sum unzip; do
    command -v "$cmd" >/dev/null 2>&1 || die "依赖安装后仍缺少：$cmd"
  done
  if ! command -v ss >/dev/null 2>&1 && ! command -v lsof >/dev/null 2>&1; then
    die "依赖安装后仍缺少 ss 或 lsof。"
  fi
}


# ---------------------------------------------------------------------------
# 下载、校验，以及安全复用已验证的同版本官方二进制
# ---------------------------------------------------------------------------
diagnose_curl() {
  local url="$1" code="$2" curl_rc="$3"
  err "下载失败：$url"
  err "curl 退出码：${curl_rc}，HTTP 状态：${code:-无}"
  case "$curl_rc" in
    6)  err "诊断：无法解析主机名，请检查 DNS 或到 GitHub 的网络。" ;;
    7)  err "诊断：连不上服务器，请检查出口网络、代理或防火墙。" ;;
    28) err "诊断：连接或传输超时。" ;;
    35) err "诊断：TLS 握手失败，请检查系统时间与证书。" ;;
    22|0)
      if [[ -n "$code" && "$code" != "200" ]]; then
        err "诊断：HTTP ${code}。若是 404，请确认版本 ${XRAY_VERSION} 的资源名未写错；本脚本不会改下最新版。"
      fi
      ;;
    *)  err "诊断：请根据 curl 退出码检查网络。本脚本只从固定地址拉取 ${XRAY_VERSION}。" ;;
  esac
  info "如 GitHub 不可达，可设置 SS_NODE_RELEASE_BASE 指向你镜像的同类路径，但仍会校验官方哈希。"
}

download_file() {
  local url="$1" dest="$2"
  local tmp code rc
  tmp="${dest}.part"
  set +e
  code="$(curl -fsSL --connect-timeout 20 --max-time 300 -A "ss-node-installer/${SCRIPT_VERSION}" \
    -o "$tmp" -w '%{http_code}' "$url")"
  rc=$?
  set -e
  if [[ $rc -ne 0 || "$code" != "200" ]]; then
    diagnose_curl "$url" "$code" "$rc"
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$dest"
}

parse_dgst_sha256() {
  local dgst="$1"
  python3 - "$dgst" <<'PY'
import re,sys
text=open(sys.argv[1],encoding='utf-8',errors='replace').read()
m=re.search(r'^(?:SHA2-256|SHA256)\s*=\s*([0-9a-fA-F]{64})\s*$', text, re.M)
if not m:
    sys.exit('无法从官方 .dgst 文件解析 SHA2-256')
print(m.group(1).lower())
PY
}

verify_binary_version() {
  local bin="$1"
  local out
  out="$("$bin" version 2>&1 || true)"
  printf '%s\n' "$out" | grep -Eq "Xray[[:space:]]+${XRAY_VERSION#v}|${XRAY_VERSION}" \
    || die "二进制版本不是 ${XRAY_VERSION}。输出为：$(printf '%s' "$out" | tr '\n' ' ' | cut -c1-200)。已中止，不会改用其他版本。"
}

verify_official_binary_file() {
  local bin="$1"
  local got
  [[ -f "$bin" && -s "$bin" ]] || return 1
  got="$(sha256_of "$bin")"
  [[ "$got" == "$PINNED_SHA256_BIN" ]] || return 1
  verify_binary_version "$bin"
}

# 返回可用于复制的已验证二进制路径（0）；找不到则 1。不修改候选文件。
find_reusable_official_binary() {
  local cand cands=()
  [[ -n "${SS_NODE_XRAY_BIN:-}" ]] && cands+=("${SS_NODE_XRAY_BIN}")
  [[ -e "${BIN_DIR}/xray" ]] && cands+=("${BIN_DIR}/xray")
  [[ -e "${XHTTP_PREFIX}/bin/xray" ]] && cands+=("${XHTTP_PREFIX}/bin/xray")
  for cand in "${cands[@]+"${cands[@]}"}"; do
    [[ -n "$cand" ]] || continue
    if [[ -L "$cand" ]]; then
      cand="$(readlink -f "$cand" || true)"
      [[ -n "$cand" ]] || continue
    fi
    if [[ -f "$cand" ]] && verify_official_binary_file "$cand"; then
      printf '%s' "$cand"
      return 0
    fi
  done
  return 1
}

download_and_verify_zip() {
  local work="$1"
  local zip_path="${work}/${ASSET_ZIP}"
  local dgst_path="${work}/${ASSET_DGST}"
  local url_zip="${RELEASE_BASE}/${ASSET_ZIP}"
  local url_dgst="${RELEASE_BASE}/${ASSET_DGST}"
  info "下载官方 ${XRAY_VERSION}：${ASSET_ZIP}"
  download_file "$url_dgst" "$dgst_path" || die "无法下载官方校验和文件。"
  download_file "$url_zip" "$zip_path" || die "无法下载官方二进制压缩包。"
  local official_sha file_sha
  official_sha="$(parse_dgst_sha256 "$dgst_path")"
  file_sha="$(sha256_of "$zip_path")"
  if [[ "$official_sha" != "$PINNED_SHA256" ]]; then
    die "官方 .dgst 中的 SHA2-256（${official_sha}）与脚本钉死的哈希（${PINNED_SHA256}）不一致。已中止，既不会改用最新版，也不会忽略校验。"
  fi
  if [[ "$file_sha" != "$official_sha" ]]; then
    die "压缩包 SHA256（${file_sha}）与官方 .dgst（${official_sha}）不一致，已删除并中止。这只是哈希校验，不是签名认证。"
  fi
  info "校验通过：官方 .dgst SHA2-256 与钉死哈希一致。这不是供应链签名认证。"
  printf '%s' "$zip_path"
}

extract_xray() {
  local zip_path="$1" dest_dir="$2"
  mkdir -p "$dest_dir"
  unzip -o -q "$zip_path" -d "$dest_dir"
  [[ -f "${dest_dir}/xray" ]] || die "压缩包中未找到 xray 可执行文件。"
  chmod 0755 "${dest_dir}/xray"
  local bin_sha
  bin_sha="$(sha256_of "${dest_dir}/xray")"
  if [[ "$bin_sha" != "$PINNED_SHA256_BIN" ]]; then
    die "解压后的 xray 二进制哈希（${bin_sha}）与脚本钉死值不一致。已中止，不会安装。"
  fi
  verify_binary_version "${dest_dir}/xray"
}

# 把已验证二进制放到 work/xray，供后续安装到本脚本目录。不改动来源文件。
obtain_verified_binary() {
  local work="$1"
  mkdir -p "$work"
  local reused
  if reused="$(find_reusable_official_binary)"; then
    install -m 0755 "$reused" "${work}/xray"
    verify_official_binary_file "${work}/xray" || die "复制后的二进制未能通过校验。"
    if [[ "$reused" == "${BIN_DIR}/xray" ]]; then
      BIN_SOURCE_NOTE="复用本脚本目录中已校验的官方 ${XRAY_VERSION} 二进制，跳过下载。"
    elif [[ "$reused" == "${XHTTP_PREFIX}/bin/xray" || "$reused" == "$(readlink -f "${XHTTP_PREFIX}/bin/xray" 2>/dev/null || true)" ]]; then
      BIN_SOURCE_NOTE="已从 ${reused} 复制校验通过的官方 ${XRAY_VERSION} 二进制到本脚本目录。同版本不等于同一进程；不会修改 XHTTP 的配置或服务，也不会改用符号链接以免日后被对方升级或卸载牵连。"
    else
      BIN_SOURCE_NOTE="已从 ${reused} 复制校验通过的官方 ${XRAY_VERSION} 二进制到本脚本目录（独立副本，不修改来源）。"
    fi
    info "$BIN_SOURCE_NOTE"
    printf '%s' "${work}/xray"
    return 0
  fi
  if [[ -e "${XHTTP_PREFIX}/bin/xray" ]]; then
    info "发现 ${XHTTP_PREFIX}/bin/xray，但未能通过本脚本钉死的 ${XRAY_VERSION} 哈希/版本校验，不会使用该文件，也不会改写它。将改为下载官方发布包。"
  fi
  local zip extract
  extract="$(mktemp -d "${TMPDIR:-/tmp}/ss-node-ex.XXXXXX")"
  zip="$(download_and_verify_zip "$work")"
  extract_xray "$zip" "$extract"
  install -m 0755 "${extract}/xray" "${work}/xray"
  rm -rf "$extract"
  BIN_SOURCE_NOTE="已下载并校验官方 ${XRAY_VERSION}，将安装到本脚本目录 ${BIN_DIR}/xray（独立副本）。"
  info "$BIN_SOURCE_NOTE"
  printf '%s' "${work}/xray"
}

install_binaries_from_work() {
  local bin="$1"
  mkdir -p "$BIN_DIR"
  install -m 0755 "$bin" "${BIN_DIR}/xray"
  chown root:root "${BIN_DIR}/xray" 2>/dev/null || true
  chmod 0755 "${BIN_DIR}/xray"
  verify_official_binary_file "${BIN_DIR}/xray" || die "安装到 ${BIN_DIR}/xray 后校验失败。"
}

# ---------------------------------------------------------------------------
# 密码、配置、SIP002 链接
# ---------------------------------------------------------------------------
generate_password() {
  local method="$1"
  python3 - "$method" <<'PYCODE'
import base64,secrets,sys
method=sys.argv[1]
if method.startswith("2022-blake3-"):
    need={"2022-blake3-aes-128-gcm":16,"2022-blake3-aes-256-gcm":32,"2022-blake3-chacha20-poly1305":32}.get(method)
    if not need:
        raise SystemExit("unknown 2022 method")
    print(base64.b64encode(secrets.token_bytes(need)).decode("ascii"))
else:
    print(secrets.token_urlsafe(32))
PYCODE
}

validate_password_for_method() {
  local method="$1" password="$2"
  python3 - "$method" "$password" <<'PYCODE'
import base64,sys,binascii
method,password=sys.argv[1],sys.argv[2]
if not password or "\n" in password or "\r" in password:
    sys.exit(2)
if method.startswith("2022-blake3-"):
    need={"2022-blake3-aes-128-gcm":16,"2022-blake3-aes-256-gcm":32,"2022-blake3-chacha20-poly1305":32}.get(method)
    if not need:
        sys.exit(3)
    try:
        raw=base64.b64decode(password, validate=False)
    except (binascii.Error, ValueError):
        sys.exit(4)
    # 官方：该长度必须匹配；Go 实现中 32 字节密钥通常也能用于 128-gcm，但本脚本按方法生成正确长度
    if method=="2022-blake3-aes-128-gcm" and len(raw) not in (16,32):
        sys.exit(5)
    if method!="2022-blake3-aes-128-gcm" and len(raw)!=need:
        sys.exit(5)
else:
    if len(password) < 16:
        sys.exit(6)
sys.exit(0)
PYCODE
}

