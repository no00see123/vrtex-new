run_change_method() {
  local old_method
  if [[ $SANDBOX -eq 0 ]]; then
    if [[ "$(id -u)" != "0" ]]; then
      die "更换加密方式需要 root。请使用：sudo bash ${SCRIPT_NAME} --change-method ${DEFAULT_METHOD}"
    fi
    os_supported || die "仅支持 Debian 或 Ubuntu（当前：$(os_id:-未知)）。"
