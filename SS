  testdir="$(mktemp -d "${TMPDIR:-/tmp}/ss-node-selftest.XXXXXX")"
  info "自检目录：${testdir}"
  SANDBOX=1
  SKIP_SYSTEMD=1

  info "运行 bash -n …"
  bash -n "$0" || { err "bash -n 失败"; return 1; }

  if command -v shellcheck >/dev/null 2>&1; then
    info "运行已有 shellcheck …"
    shellcheck -x "$0" || rc=1
  else
    local sc_dir="${testdir}/shellcheck"
    mkdir -p "$sc_dir"
    info "本机无 shellcheck，尝试把官方预编译包解压到临时目录（不全局安装）…"
    if curl -fsSL --connect-timeout 15 --max-time 60 \
        -o "${sc_dir}/shellcheck.tar.xz" \
        'https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.x86_64.tar.xz' \
        && tar -xJf "${sc_dir}/shellcheck.tar.xz" -C "$sc_dir"; then
      local sc
      sc="$(find "$sc_dir" -type f -name shellcheck | head -n1)"
      if [[ -n "$sc" ]]; then
        chmod +x "$sc"
        "$sc" -x "$0" || rc=1
      else
        warn "临时 shellcheck 解压后未找到可执行文件，已跳过。"
      fi
    else
      warn "无法下载临时 shellcheck，已跳过该项。bash -n 已执行。"
    fi
  fi

