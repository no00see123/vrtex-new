  [[ "$(canonical_method 2022-blake3-aes-128-gcm)" == "$METHOD_SS2022" ]] || { err "ss2022 规范化失败"; rc=1; }
  if canonical_method none >/dev/null 2>&1 || canonical_method plain >/dev/null 2>&1 || canonical_method rc4-md5 >/dev/null 2>&1 || canonical_method aes-256-cfb >/dev/null 2>&1; then
