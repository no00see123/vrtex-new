query_unit_status() {
  local active="未知" enabled="未知"
  if ! command -v systemctl >/dev/null 2>&1; then
    printf '%s\n%s\n' "未知（无 systemctl）" "未知"
    return 0
  fi
  active="$(systemctl is-active "$UNIT_NAME" 2>/dev/null || true)"
  enabled="$(systemctl is-enabled "$UNIT_NAME" 2>/dev/null || true)"
  [[ -n "$active" ]] || active="未知"
  [[ -n "$enabled" ]] || enabled="未知"
  printf '%s\n%s\n' "$active" "$enabled"
}

read_local_core_version() {
  local bin="$1"
  if [[ ! -x "$bin" ]]; then
    printf '%s' "未找到本地二进制 ${bin}"
    return 0
  fi
  local out
  out="$("$bin" version 2>&1 || true)"
  out="$(printf '%s' "$out" | tr '\r' ' ' | head -n 3 | tr '\n' ' ')"
  out="${out%"${out##*[![:space:]]}"}"
  if [[ -z "$out" ]]; then
    printf '%s' "已找到二进制，但 version 无输出"
    return 0
  fi
  printf '%s' "$out"
}

run_info() {
  init_paths
  if ! command -v python3 >/dev/null 2>&1; then
    die "查看节点信息需要 python3。请自行安装后再运行。本命令不会代为安装依赖，也不会开始安装节点或重置密码。"
  fi

  local has_layout=0
  if [[ -d "$PREFIX" || -e "$STATE_FILE" || -e "$CONFIG_FILE" || -e "$UNIT_PATH" ]]; then
    has_layout=1
  fi
  if [[ $has_layout -eq 0 ]]; then
    die "未检测到本脚本的安装（目录 ${PREFIX}；若安装在其他路径，请设置 SS_NODE_PREFIX 后再查询）。本命令只查询，不会开始安装或生成新密码。"
  fi
  if [[ ! -r "$STATE_FILE" ]]; then
    if [[ "$(id -u)" != "0" ]]; then
      die "无法读取 ${STATE_FILE}。查看节点信息请使用：sudo bash ${SCRIPT_NAME} --info。本命令只查询，不会因此重新安装或重置密码。"
    fi
    if [[ ! -e "$STATE_FILE" ]]; then
      die "找不到身份文件 ${STATE_FILE}。不会自动重新生成密码。若 1.0.0 首次安装在写入身份前失败，目录里可能只有空的 etc；请用 1.0.1 或更新脚本重新运行安装（不必删除目录）。若确认曾安装成功，请检查该文件是否被移动或损坏。"
    fi
    die "无法读取身份文件 ${STATE_FILE}。已中止，不会重置密码或改写文件。"
  fi

  local active enabled core_ver status_lines
  status_lines="$(query_unit_status)"
  active="$(printf '%s\n' "$status_lines" | sed -n '1p')"
  enabled="$(printf '%s\n' "$status_lines" | sed -n '2p')"
  core_ver="$(read_local_core_version "${BIN_DIR}/xray")"

  with_secrets_quiet python3 - \
    "$STATE_FILE" "$CONFIG_FILE" "$LINK_FILE" \
    "$active" "$enabled" "$core_ver" \
    "$SCRIPT_VERSION" "$XRAY_VERSION" "$UNIT_NAME" "$PREFIX" \
    <<'PYCODE'
import base64, json, os, sys, urllib.parse

state_path, config_path, link_path = sys.argv[1], sys.argv[2], sys.argv[3]
active, enabled, core_ver = sys.argv[4], sys.argv[5], sys.argv[6]
script_ver, pin_ver, unit_name, prefix = sys.argv[7], sys.argv[8], sys.argv[9], sys.argv[10]

def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)

try:
    with open(state_path, encoding="utf-8") as f:
        st = json.load(f)
except json.JSONDecodeError:
    fail("身份文件 %s 不是有效的 JSON，已中止。不会重置密码或改写文件。" % state_path)
except OSError as e:
    fail("无法读取身份文件 %s：%s。已中止，不会重置密码。" % (state_path, e))
if not isinstance(st, dict):
    fail("身份文件 %s 格式不正确（应为对象）。已中止，不会重置密码。" % state_path)

def field(key):
    v = st.get(key, "")
    if v is None:
        return ""
    if isinstance(v, list):
        return ",".join(str(x) for x in v)
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        if int(v) == v:
            return str(int(v))
        return str(v)
    return str(v)

remark = field("remark")
port = field("port")
method = field("method")
password = field("password")
address = field("address")
listen = field("listen")
network = field("network") or "tcp,udp"
state_ver = field("version")
missing = [k for k, v in (
    ("remark", remark), ("port", port), ("method", method),
    ("password", password), ("address", address),
) if not v]
if missing:
    fail("身份文件缺少必要字段：%s。已中止，不会重置密码、改写文件，也不会向公网查询或编造地址。" % "、".join(missing))

def address_line(addr):
    import ipaddress
    raw=(addr or "").strip()
    if not raw:
        fail("身份文件中的服务器地址为空。已中止，不会向公网查询或编造地址。")
    core=raw[1:-1] if raw.startswith("[") and raw.endswith("]") else raw
    try:
        ipaddress.ip_address(core)
        return "服务器地址（IP）：%s" % raw
    except ValueError:
        return "服务器地址（域名）：%s" % raw

config_warn = ""
if os.path.isfile(config_path):
    try:
        with open(config_path, encoding="utf-8") as f:
            cfg = json.load(f)
        ib = (cfg.get("inbounds") or [None])[0]
        if not isinstance(ib, dict):
            config_warn = "配置文件缺少 inbounds，以下信息来自身份文件。"
        else:
            settings = ib.get("settings") or {}
            diffs = []
            if str(ib.get("port", "")) and str(ib.get("port")) != port:
                diffs.append("端口")
            if settings.get("method") and settings.get("method") != method:
                diffs.append("加密方式")
            if settings.get("password") and settings.get("password") != password:
                diffs.append("密码")
            if ib.get("protocol") and ib.get("protocol") != "shadowsocks":
                diffs.append("协议")
            if diffs:
                config_warn = "配置文件与身份文件在 %s 上不一致；导入链接按身份文件重建（未写入磁盘）。" % "、".join(diffs)
    except json.JSONDecodeError:
        config_warn = "配置文件不是有效的 JSON；以下信息来自身份文件。"
    except OSError as e:
        config_warn = "配置文件存在但无法读取：%s" % e
else:
    config_warn = "未找到配置文件 %s；以下信息来自身份文件。" % config_path

host = address
if host and not (host.startswith("[") and host.endswith("]")) and ":" in host:
    host = "[%s]" % host
if method.startswith("2022-"):
    userinfo = "%s:%s" % (urllib.parse.quote(method, safe=""), urllib.parse.quote(password, safe=""))
else:
    raw = ("%s:%s" % (method, password)).encode("utf-8")
    userinfo = base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")
frag = urllib.parse.quote(remark, safe="")
uri = "ss://%s@%s:%s#%s" % (userinfo, host, port, frag)
uri_note = "根据身份文件在内存中重建（未写入磁盘）。"
if os.path.isfile(link_path):
    try:
        disk = open(link_path, encoding="utf-8").read().strip()
    except OSError:
        disk = ""
    if disk == uri:
        uri_note = "与本机链接文件一致。"
    elif disk.startswith("ss://"):
        uri_note = "本机链接文件与当前身份不一致，以下为按身份文件在内存中重建的链接（未写入磁盘）。"
    elif disk:
        uri_note = "本机链接文件无法识别，以下为按身份文件在内存中重建的链接（未写入磁盘）。"

active_note = active
if active not in ("active",):
    active_note = "%s（服务未处于运行状态；以下仍是已写入的配置）" % active

lines = [
    "节点名称：%s" % remark,
    address_line(address),
    "端口：%s" % port,
    "密码：%s" % password,
    "加密方式：%s" % method,
    "协议：Shadowsocks",
    "传输：RAW（普通 TCP 流；入站同时监听 TCP 与 UDP）",
    "安全：无（未启用 TLS。这不等于未加密，流量由 Shadowsocks 自身加密。）",
    "UDP over TCP（UoT）：关闭",
    "完整分享链接：",
    uri,
    "（%s）" % uri_note,
    "",
    "说明：以上是本机落地参数。若前面还有中转，客户端应使用中转入口地址和端口；两者不是同一条链接。",
    "说明：已监听原生 UDP，但不等于中转或客户端一定能走 UDP。TCP 能通也不等于加密方式已对齐。",
]
if config_warn:
    lines.append("说明：%s" % config_warn)
lines += [
    "",
    "服务状态：%s" % active_note,
    "开机启用：%s" % enabled,
    "核心版本：%s" % core_ver,
    "脚本钉死官方版本：%s" % (state_ver or pin_ver),
    "安装脚本版本：%s" % script_ver,
    "安装目录：%s" % prefix,
    "系统服务：%s" % unit_name,
    "监听：%s" % (listen or "（身份文件未记录）"),
    "入站 network：%s" % network,
]
sys.stdout.write("\n".join(lines) + "\n")
PYCODE
}


