  if awk 'BEGIN{p=1} /^self_test\(\)/{p=0} p' "$0" | grep -E '^[[:space:]]*chmod[[:space:]]+(-[^[:space:]]+[[:space:]]+)*0?777([^0-9]|$)' >/dev/null; then
