      rollback_install
      die "新算法配置校验失败，已恢复原来的加密方式、密码和链接。"
    fi
  fi
  write_link_file
  if [[ $SANDBOX -eq 1 ]]; then
    fix_permissions
    echo
    print_connection_card
    echo
    info "沙箱模式：已写入新算法的配置与客户端文件，未重启系统服务。"
    info "请把入口 3x-ui / 客户端的加密方式同步为 ${METHOD}，密码、地址和端口保持不变。仅重新跑安装不会完成这次迁移。"
    return 0
  fi
  fix_permissions
  assert_runtime_access
  restart_our_service_after_port_change
  echo
  print_connection_card
  echo
  info "更换加密方式完成：${old_method} -> ${METHOD}。密码、端口、地址和名称未改动。"
  info "请同步入口 3x-ui 出站与客户端的加密方式为 ${METHOD}，否则路由会启用但仍无法认证。TCP 能通不等于算法已对齐。"
}


