# SIP002：经典 AEAD 推荐 Base64URL(userinfo)；SS2022（SIP022）不得用 Base64URL，必须百分号编码 method:password。
build_share_uri() {
  URI_METHOD="$METHOD" URI_PASSWORD="$PASSWORD" URI_HOST="$SERVER_ADDRESS" \
  URI_PORT="$PORT" URI_REMARK="$REMARK" \
  python3 - <<'PY'
import base64,os,urllib.parse
method=os.environ["URI_METHOD"]
password=os.environ["URI_PASSWORD"]
host=os.environ["URI_HOST"]
port=os.environ["URI_PORT"]
remark=os.environ.get("URI_REMARK","")
if host and not (host.startswith("[") and host.endswith("]")) and ":" in host:
    host=f"[{host}]"
if method.startswith("2022-"):
    userinfo="%s:%s" % (urllib.parse.quote(method, safe=""), urllib.parse.quote(password, safe=""))
else:
    raw=f"{method}:{password}".encode("utf-8")
    userinfo=base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")
frag=urllib.parse.quote(remark, safe="")
print(f"ss://{userinfo}@{host}:{port}#{frag}")
PY
}

validate_config() {
  local bin="$1" cfg="$2"
  local out rc
  set +e
  out="$("$bin" run -test -config "$cfg" 2>&1)"
  rc=$?
  set -e
  if [[ $rc -ne 0 ]] || ! printf '%s\n' "$out" | grep -q 'Configuration OK.'; then
    err "配置校验未通过（xray run -test）。已避免启用服务。"
    printf '%s\n' "$out" | python3 -c 'import sys,re
# 省略可能含密码的行，并区分弃用警告与真正失败
pat=re.compile(r"(password|Password)\s*[:=].*", re.I)
for line in sys.stdin:
    if pat.search(line):
        sys.stderr.write("[已省略可能含密码的行]\n")
        continue
    sys.stderr.write(line)
' >&2
    return 1
  fi
  if printf '%s\n' "$out" | grep -qi 'deprecated'; then
    info "该版 Xray 在加载 Shadowsocks 时会给出弃用提示（无前向保密，官方更推荐 VLESS Encryption）。这不是配置错误，校验已通过。"
  fi
  return 0
}

backup_if_exists() {
  local src="$1" dest="$2"
  if [[ -e "$src" ]]; then
    cp -a "$src" "$dest"
  fi
}

prepare_rollback_snapshots() {
  local bak
  bak="${ETC_DIR}/.rollback.$$"
  mkdir -p "$bak"
  chmod 700 "$bak"
  PREV_CONFIG_BAK=''
  PREV_STATE_BAK=''
  PREV_LINK_BAK=''
  PREV_UNIT_BAK=''
  PREV_UNIT_ENABLED=''
  PREV_UNIT_ACTIVE=''
  if [[ -e "$CONFIG_FILE" ]]; then
    PREV_CONFIG_BAK="${bak}/config.json"
    backup_if_exists "$CONFIG_FILE" "$PREV_CONFIG_BAK"
  fi
  if [[ -e "$STATE_FILE" ]]; then
    PREV_STATE_BAK="${bak}/state.json"
    backup_if_exists "$STATE_FILE" "$PREV_STATE_BAK"
  fi
  if [[ -e "$LINK_FILE" ]]; then
    PREV_LINK_BAK="${bak}/client-link.txt"
    backup_if_exists "$LINK_FILE" "$PREV_LINK_BAK"
  fi
  if have_systemd && [[ -e "$UNIT_PATH" ]]; then
    PREV_UNIT_BAK="${bak}/ss-node.service"
    backup_if_exists "$UNIT_PATH" "$PREV_UNIT_BAK"
    if [[ $SKIP_SYSTEMD -eq 0 ]]; then
      PREV_UNIT_ENABLED="$(systemctl is-enabled "$UNIT_NAME" 2>/dev/null || true)"
      PREV_UNIT_ACTIVE="$(systemctl is-active "$UNIT_NAME" 2>/dev/null || true)"
    fi
  fi
}

rollback_install() {
  warn "正在回滚，避免留下无法启动的配置。"
  if [[ $SKIP_SYSTEMD -eq 0 ]] && have_systemd; then
    if [[ $SERVICE_STARTED_THIS_RUN -eq 1 ]]; then
      systemctl stop "$UNIT_NAME" >/dev/null 2>&1 || true
    fi
    if [[ -n "$PREV_UNIT_BAK" && -e "$PREV_UNIT_BAK" ]]; then
      cp -a "$PREV_UNIT_BAK" "$UNIT_PATH"
      systemctl daemon-reload >/dev/null 2>&1 || true
      if [[ "$PREV_UNIT_ENABLED" == "enabled" ]]; then
        systemctl enable "$UNIT_NAME" >/dev/null 2>&1 || true
      fi
      if [[ "$PREV_UNIT_ACTIVE" == "active" ]]; then
        systemctl start "$UNIT_NAME" >/dev/null 2>&1 || true
      fi
    elif [[ $NEW_UNIT_WRITTEN -eq 1 && -z "$PREV_UNIT_BAK" ]]; then
      systemctl disable --now "$UNIT_NAME" >/dev/null 2>&1 || true
      rm -f "$UNIT_PATH"
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
  fi
  [[ -n "$PREV_CONFIG_BAK" && -e "$PREV_CONFIG_BAK" ]] && cp -a "$PREV_CONFIG_BAK" "$CONFIG_FILE"
  [[ -n "$PREV_STATE_BAK" && -e "$PREV_STATE_BAK" ]] && cp -a "$PREV_STATE_BAK" "$STATE_FILE"
  [[ -n "$PREV_LINK_BAK" && -e "$PREV_LINK_BAK" ]] && cp -a "$PREV_LINK_BAK" "$LINK_FILE"
}

