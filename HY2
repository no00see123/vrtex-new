# ---------------------------------------------------------------------------
detect_3xui() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl list-unit-files 2>/dev/null | grep -Eq '^x-ui\.service' && return 0
    systemctl is-active --quiet x-ui 2>/dev/null && return 0
  fi
  [[ -e /usr/local/x-ui || -e /usr/local/bin/x-ui ]] && return 0
  return 1
}

detect_other_xray() {
  local hits=()
  command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files 2>/dev/null | grep -Eq '^xray\.service' && hits+=("xray.service")
  [[ -e /usr/local/bin/xray ]] && hits+=("/usr/local/bin/xray")
  [[ -e /usr/local/etc/xray || -e /etc/xray ]] && hits+=("xray-config")
  if [[ ${#hits[@]} -gt 0 ]]; then
    printf '%s' "${hits[*]}"
    return 0
  fi
  return 1
}

detect_other_hysteria() {
  local hits=()
  if command -v systemctl >/dev/null 2>&1; then
    systemctl list-unit-files 2>/dev/null | grep -Eq '^hysteria-server\.service' && hits+=("hysteria-server.service")
    systemctl list-unit-files 2>/dev/null | grep -Eq '^hysteria-server@' && hits+=("hysteria-server@.service")
  fi
  if [[ -e /usr/local/bin/hysteria ]]; then
    if [[ ! -e "$BIN_DIR/hysteria" ]] || [[ ! /usr/local/bin/hysteria -ef "$BIN_DIR/hysteria" ]]; then
      hits+=("/usr/local/bin/hysteria")
    fi
  fi
  [[ -e /etc/hysteria ]] && hits+=("/etc/hysteria")
  if [[ ${#hits[@]} -gt 0 ]]; then
    printf '%s' "${hits[*]}"
    return 0
  fi
  return 1
}

port_listeners() {
  local proto="$1" port="$2"
  if command -v ss >/dev/null 2>&1; then
    if [[ "$proto" == "udp" ]]; then
      ss -H -ulnp "sport = :$port" 2>/dev/null || true
    else
      ss -H -tlnp "sport = :$port" 2>/dev/null || true
    fi
  elif command -v lsof >/dev/null 2>&1; then
    if [[ "$proto" == "udp" ]]; then
      lsof -nP -iUDP:"$port" 2>/dev/null || true
    else
      lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
    fi
  else
    die "需要 ss 或 lsof 才能检查端口占用。"
  fi
}

listener_is_ours() {
  local text="$1"
  [[ "$text" == *"${BIN_DIR}/hysteria"* ]] && return 0
  [[ "$text" == *"hy2-node"* ]] && return 0
  return 1
}

assert_udp_port_free() {
  local port="$1" text
  text="$(port_listeners udp "$port")"
  [[ -n "$text" ]] || return 0
  if listener_is_ours "$text"; then
    info "UDP ${port} 当前由本脚本的服务占用，可继续更新。"
    return 0
  fi
  err "UDP 端口 ${port} 已被占用，本脚本不会停止占用该端口的进程："
  printf '%s\n' "$text" >&2
  die "请改用其他 UDP 端口后重试。"
}

assert_tcp80_or_existing_cert() {
  local text
  text="$(port_listeners tcp 80)"
  if [[ -z "$text" ]]; then
    return 0
  fi
  if listener_is_ours "$text"; then
    info "TCP 80 当前由本脚本服务用于 ACME，可继续。"
    return 0
  fi
  if [[ "$TLS_MODE" == "existing" ]]; then
    info "TCP 80 已被其他程序占用；将使用你提供的已有证书，不会结束占用 80 端口的进程。"
    return 0
  fi
  err "HTTP-01 证书申请需要本机 TCP 80 可被本服务监听，但该端口已被占用。本脚本不会结束他人进程或改写他人网站："
  printf '%s\n' "$text" >&2
  err "可选：提供已由受信任 CA 签发、且覆盖该域名的证书和私钥（HY2_NODE_TLS_CERT / HY2_NODE_TLS_KEY），或先自行释放 80 端口后再用官方内置 ACME。"
  die "未选择可用的证书方案，已中止。"
}

preflight_conflicts() {
  if detect_3xui; then
    warn "检测到可能存在的 3x-ui（x-ui 服务或 /usr/local/x-ui）。本脚本不会覆盖、停止或改写它。"
  fi
  local other
  if other="$(detect_other_xray)"; then
    warn "检测到已有 Xray：${other}。本脚本安装到 ${PREFIX} 与 ${UNIT_NAME}，不会覆盖这些路径，也不会停止现有服务。"
  fi
  if other="$(detect_other_hysteria)"; then
    warn "检测到已有 Hysteria：${other}。本脚本不会覆盖 /etc/hysteria、hysteria-server.service 或 /usr/local/bin/hysteria，也不会停止它们。"
  fi
  if [[ -e /usr/local/bin/hysteria && -e "$BIN_DIR/hysteria" && "$BIN_DIR/hysteria" -ef /usr/local/bin/hysteria ]]; then
    die "安装路径与已有 /usr/local/bin/hysteria 重合，已拒绝覆盖。"
  fi
  if [[ "$UNIT_PATH" == /etc/systemd/system/hysteria-server.service || "$UNIT_PATH" == /etc/systemd/system/hysteria-server@.service ]]; then
    die "拒绝覆盖官方 hysteria-server 单元。"
  fi
  if [[ "$PREFIX" == /etc/hysteria ]]; then
    die "拒绝使用 /etc/hysteria 作为安装目录。"
  fi
}

# ---------------------------------------------------------------------------
# sysctl、防火墙、回滚、服务
# ---------------------------------------------------------------------------
maybe_prompt_mode() {
  local current="$1"
  if [[ -n "$current" ]]; then
    printf '%s' "$current"
    return
  fi
  if [[ $ASSUME_YES -eq 1 ]]; then
    printf 'yes'
    return
  fi
  if [[ -t 0 ]]; then
    printf 'ask'
  else
    printf 'no'
  fi
}

read_sysctl_value() {
  local key="$1"
  sysctl -n "$key" 2>/dev/null || echo 0
}

maybe_apply_udp_buffers() {
  local mode
  mode="$(maybe_prompt_mode "${SYSCTL_MODE}")"
  info "如需提高 UDP 套接字缓冲上限，本脚本只会写入 net.core.rmem_max 与 net.core.wmem_max 两项，且不会把已经更大的值改小。这与 QUIC 窗口不是同一回事，也不会改 TCP BBR 或路由。"
  case "$mode" in
    no|NO|0)
      info "已跳过 sysctl 写入。若发送/接收缓冲偏小，可稍后自行将上述两项至少调到 ${UDP_BUF_MIN}。"
      return 0
      ;;
    yes|YES|1)
      ;;
    ask|ASK)
      if confirm "是否写入仅含上述两项的 ${SYSCTL_FILE}，并把当前小于 ${UDP_BUF_MIN} 的值提高到该下限？"; then
        mode='yes'
      else
        info "已跳过 sysctl 写入。"
        return 0
      fi
      ;;
    *) die "HY2_NODE_SYSCTL 只能是 yes、no 或 ask。" ;;
  esac
  if [[ $SANDBOX -eq 1 ]]; then
    info "沙箱模式：只演示将要写入的 sysctl 值，不修改系统。"
    return 0
  fi
  local cur_r cur_w new_r new_w
  cur_r="$(read_sysctl_value net.core.rmem_max)"
  cur_w="$(read_sysctl_value net.core.wmem_max)"
  new_r="$cur_r"
  new_w="$cur_w"
  [[ "$cur_r" =~ ^[0-9]+$ ]] || cur_r=0
  [[ "$cur_w" =~ ^[0-9]+$ ]] || cur_w=0
  if (( cur_r < UDP_BUF_MIN )); then new_r="$UDP_BUF_MIN"; else new_r="$cur_r"; fi
  if (( cur_w < UDP_BUF_MIN )); then new_w="$UDP_BUF_MIN"; else new_w="$cur_w"; fi
  if [[ -f "$SYSCTL_FILE" ]]; then
    PREV_SYSCTL_BAK="${ETC_DIR}/.rollback.$$/99-hy2-node.conf"
    mkdir -p "$(dirname "$PREV_SYSCTL_BAK")"
    cp -a "$SYSCTL_FILE" "$PREV_SYSCTL_BAK"
  fi
  cat >"$SYSCTL_FILE" <<EOF
# written by ${SCRIPT_NAME}; only these two keys
net.core.rmem_max = ${new_r}
net.core.wmem_max = ${new_w}
EOF
  NEW_SYSCTL_WRITTEN=1
  sysctl -w "net.core.rmem_max=${new_r}" >/dev/null
  sysctl -w "net.core.wmem_max=${new_w}" >/dev/null
  info "已设置 net.core.rmem_max=${new_r}、net.core.wmem_max=${new_w}，并写入 ${SYSCTL_FILE}。未改动其他 sysctl。"
}

maybe_open_ports() {
  local mode
  mode="$(maybe_prompt_mode "${OPEN_PORT_MODE}")"
  local extra_tcp=""
  if [[ "$TLS_MODE" == "acme" ]]; then
    extra_tcp=" 另外，ACME HTTP-01 需要外网能访问本机 TCP 80；云厂商安全组也要放行该 TCP 端口。"
  fi
  info "需要放行本机 UDP ${PORT}。本脚本不会改默认策略或 SSH。云防火墙/安全组只能你在控制台自行放行 UDP ${PORT}。${extra_tcp}"
  case "$mode" in
    no|NO|0)
      info "已跳过本机防火墙写入。"
      return 0
      ;;
    yes|YES|1)
      ;;
    ask|ASK)
      if confirm "是否仅放行本机 UDP ${PORT}（不改默认策略、不改 SSH）？"; then
        mode='yes'
      else
        info "已跳过本机端口放行。"
        return 0
      fi
      ;;
    *) die "HY2_NODE_OPEN_PORT 只能是 yes、no 或 ask。" ;;
  esac
  if [[ $SANDBOX -eq 1 ]]; then
    info "沙箱模式：不修改防火墙。"
    return 0
  fi
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
    ufw allow "${PORT}/udp" comment 'hy2-node' || die "ufw 放行 UDP 失败。"
    if [[ "$TLS_MODE" == "acme" ]]; then
      if confirm "是否同时放行本机 TCP 80 以供 ACME HTTP-01？（不会结束占用 80 的其他进程）"; then
        ufw allow 80/tcp comment 'hy2-node-acme-http01' || die "ufw 放行 TCP 80 失败。"
      else
        info "未放行 TCP 80。若云安全组或本机防火墙挡住 80，证书申请会失败。"
      fi
    fi
    info "已通过 ufw 放行相关端口。"
    return 0
  fi
  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -q running; then
    firewall-cmd --permanent --add-port="${PORT}/udp" || die "firewalld 放行 UDP 失败。"
    if [[ "$TLS_MODE" == "acme" ]]; then
      if confirm "是否同时放行本机 TCP 80 以供 ACME HTTP-01？"; then
        firewall-cmd --permanent --add-port=80/tcp || die "firewalld 放行 TCP 80 失败。"
      fi
    fi
    firewall-cmd --reload || true
    info "已通过 firewalld 放行相关端口。"
    return 0
  fi
  warn "未检测到已启用的 ufw 或 firewalld。本脚本不会擅自改 iptables/nft 默认策略。请自行放行 UDP ${PORT}，并检查云防火墙/安全组。若用 ACME，还需放行 TCP 80。"
}

backup_if_exists() {
  local src="$1" dest="$2"
  if [[ -e "$src" ]]; then
    cp -a "$src" "$dest"
  fi
}

prepare_rollback_snapshots() {
  local bak
  bak="${ETC_DIR}/.rollback.$$"
  mkdir -p "$bak"
  chmod 700 "$bak"
  PREV_CONFIG_BAK=''
  PREV_STATE_BAK=''
  PREV_LINK_BAK=''
  PREV_MIHOMO_BAK=''
  PREV_UNIT_BAK=''
  PREV_BIN_BAK=''
  if [[ -e "$CONFIG_FILE" ]]; then
    PREV_CONFIG_BAK="${bak}/config.yaml"
    backup_if_exists "$CONFIG_FILE" "$PREV_CONFIG_BAK"
  fi
  if [[ -e "$STATE_FILE" ]]; then
    PREV_STATE_BAK="${bak}/state.json"
    backup_if_exists "$STATE_FILE" "$PREV_STATE_BAK"
  fi
  if [[ -e "$LINK_FILE" ]]; then
    PREV_LINK_BAK="${bak}/client-uri.txt"
    backup_if_exists "$LINK_FILE" "$PREV_LINK_BAK"
  fi
  if [[ -e "$MIHOMO_FILE" ]]; then
    PREV_MIHOMO_BAK="${bak}/mihomo.yaml"
    backup_if_exists "$MIHOMO_FILE" "$PREV_MIHOMO_BAK"
  fi
  if [[ -e "$BIN_DIR/hysteria" ]]; then
    PREV_BIN_BAK="${bak}/hysteria"
    backup_if_exists "$BIN_DIR/hysteria" "$PREV_BIN_BAK"
  fi
  if have_systemd && [[ -e "$UNIT_PATH" ]]; then
    PREV_UNIT_BAK="${bak}/hy2-node.service"
    backup_if_exists "$UNIT_PATH" "$PREV_UNIT_BAK"
    PREV_UNIT_ENABLED="$(systemctl is-enabled "$UNIT_NAME" 2>/dev/null || true)"
    PREV_UNIT_ACTIVE="$(systemctl is-active "$UNIT_NAME" 2>/dev/null || true)"
  fi
}

rollback_install() {
  warn "正在回滚，避免留下无法启动的配置。"
  if [[ $SKIP_SYSTEMD -eq 0 ]] && have_systemd; then
    if [[ $SERVICE_STARTED_THIS_RUN -eq 1 ]]; then
      systemctl stop "$UNIT_NAME" >/dev/null 2>&1 || true
    fi
    if [[ -n "$PREV_UNIT_BAK" && -e "$PREV_UNIT_BAK" ]]; then
      cp -a "$PREV_UNIT_BAK" "$UNIT_PATH"
      systemctl daemon-reload >/dev/null 2>&1 || true
      if [[ "$PREV_UNIT_ENABLED" == "enabled" ]]; then
        systemctl enable "$UNIT_NAME" >/dev/null 2>&1 || true
      fi
      if [[ "$PREV_UNIT_ACTIVE" == "active" ]]; then
        systemctl start "$UNIT_NAME" >/dev/null 2>&1 || true
      fi
    elif [[ $NEW_UNIT_WRITTEN -eq 1 && -z "$PREV_UNIT_BAK" ]]; then
      systemctl disable --now "$UNIT_NAME" >/dev/null 2>&1 || true
      rm -f "$UNIT_PATH"
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
  fi
  [[ -n "$PREV_CONFIG_BAK" && -e "$PREV_CONFIG_BAK" ]] && cp -a "$PREV_CONFIG_BAK" "$CONFIG_FILE"
  [[ -n "$PREV_STATE_BAK" && -e "$PREV_STATE_BAK" ]] && cp -a "$PREV_STATE_BAK" "$STATE_FILE"
  [[ -n "$PREV_LINK_BAK" && -e "$PREV_LINK_BAK" ]] && cp -a "$PREV_LINK_BAK" "$LINK_FILE"
  [[ -n "$PREV_MIHOMO_BAK" && -e "$PREV_MIHOMO_BAK" ]] && cp -a "$PREV_MIHOMO_BAK" "$MIHOMO_FILE"
  [[ -n "$PREV_BIN_BAK" && -e "$PREV_BIN_BAK" ]] && cp -a "$PREV_BIN_BAK" "$BIN_DIR/hysteria"
  if [[ $NEW_SYSCTL_WRITTEN -eq 1 ]]; then
    if [[ -n "$PREV_SYSCTL_BAK" && -e "$PREV_SYSCTL_BAK" ]]; then
      cp -a "$PREV_SYSCTL_BAK" "$SYSCTL_FILE"
    else
      rm -f "$SYSCTL_FILE"
    fi
  fi
}

ensure_sysuser() {
  if id -u "$SYSUSER" >/dev/null 2>&1; then
    return 0
  fi
  useradd --system --home-dir "$VAR_DIR" --shell /usr/sbin/nologin "$SYSUSER"
}

write_unit() {
  local tmp
  tmp="$(mktemp)"
  cat >"$tmp" <<EOF
[Unit]
Description=Standalone Hysteria 2 node (${HY2_VERSION})
Documentation=https://v2.hysteria.network/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${SYSUSER}
Group=${SYSUSER}
WorkingDirectory=${PREFIX}
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=${BIN_DIR}/hysteria server --config ${CONFIG_FILE}
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=${LOG_DIR} ${ACME_DIR} ${VAR_DIR}
Environment=HYSTERIA_LOG_LEVEL=info

[Install]
WantedBy=multi-user.target
EOF
  install -m 0644 "$tmp" "$UNIT_PATH"
  rm -f "$tmp"
  NEW_UNIT_WRITTEN=1
  systemctl daemon-reload
}

fix_permissions() {
  mkdir -p "$BIN_DIR" "$ETC_DIR" "$VAR_DIR" "$LOG_DIR" "$ACME_DIR"
  chmod 0755 "$PREFIX" "$BIN_DIR" "$VAR_DIR"
  chmod 0750 "$ETC_DIR" "$LOG_DIR" "$ACME_DIR"
  if id -u "$SYSUSER" >/dev/null 2>&1; then
    chown -R root:"$SYSUSER" "$ETC_DIR" "$LOG_DIR" "$ACME_DIR" "$VAR_DIR"
    chown root:root "$BIN_DIR/hysteria" 2>/dev/null || true
    chmod 0755 "$BIN_DIR/hysteria" 2>/dev/null || true
  fi
  [[ -e "$CONFIG_FILE" ]] && chmod 0640 "$CONFIG_FILE"
  [[ -e "$STATE_FILE" ]] && chmod 0640 "$STATE_FILE"
  if [[ -e "$LINK_FILE" ]]; then
    chmod 0600 "$LINK_FILE"
    chown root:root "$LINK_FILE" 2>/dev/null || true
  fi
  if [[ -e "$MIHOMO_FILE" ]]; then
    chmod 0600 "$MIHOMO_FILE"
    chown root:root "$MIHOMO_FILE" 2>/dev/null || true
  fi
}

install_binary() {
  local src="$1"
  mkdir -p "$BIN_DIR"
  local tmp="${BIN_DIR}/hysteria.new.$$"
  cp -a "$src" "$tmp"
  chmod 0755 "$tmp"
  verify_binary_version "$tmp" || { rm -f "$tmp"; die "新二进制版本校验失败，未替换现有文件。"; }
  mv -f "$tmp" "$BIN_DIR/hysteria"
}

wait_service_ready() {
  local logtxt
  for _ in $(seq 1 90); do
    logtxt="$(journalctl -u "$UNIT_NAME" -n 80 --no-pager 2>/dev/null || true)"
    if printf '%s\n' "$logtxt" | grep -qiE 'server up and running'; then
      return 0
    fi
    if printf '%s\n' "$logtxt" | grep -qiE 'FATAL|failed to load server config|obtaining certificate|authorization failed|rateLimited'; then
      err "服务日志出现失败信息："
      printf '%s\n' "$logtxt" | tail -n 40 >&2
      return 1
    fi
    if ! systemctl is-active --quiet "$UNIT_NAME"; then
      err "服务未保持运行。"
      systemctl status "$UNIT_NAME" --no-pager -l || true
      return 1
    fi
    sleep 1
  done
  if systemctl is-active --quiet "$UNIT_NAME"; then
    warn "90 秒内未在日志中看到 server up and running，但服务仍在运行。请自行检查：journalctl -u ${UNIT_NAME} -e"
    return 0
  fi
  return 1
}

start_service() {
  systemctl enable "$UNIT_NAME"
  if ! systemctl restart "$UNIT_NAME"; then
    err "服务启动失败。"
    systemctl status "$UNIT_NAME" --no-pager -l || true
    journalctl -u "$UNIT_NAME" -n 80 --no-pager || true
    rollback_install
    die "已回滚到安装前状态（若为首次安装则已禁用并移除新单元）。"
  fi
  SERVICE_STARTED_THIS_RUN=1
  if ! wait_service_ready; then
    rollback_install
    die "服务未能就绪，已回滚。"
  fi
  info "服务 ${UNIT_NAME} 已运行。官方内置 ACME（CertMagic）会在服务运行期间自动续期并继续使用新证书，无需另装定时任务。"
}

# ---------------------------------------------------------------------------
# 已安装检测与换端口（不重装、不重签证书、不下载二进制）
# ---------------------------------------------------------------------------
read_config_listen_port() {
  local cfg="$1"
  [[ -f "$cfg" ]] || return 1
  python3 - "$cfg" <<'PYCODE'
import re,sys
text=open(sys.argv[1],encoding="utf-8").read()
m=re.search(r"(?m)^\s*listen:\s*.*:([0-9]+)\s*$", text)
if not m:
    sys.exit(1)
print(m.group(1))
PYCODE
}

load_existing_identity() {
  [[ -f "$STATE_FILE" ]] || return 1
  AUTH_PASSWORD="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("password") or "")' "$STATE_FILE")"
  [[ -n "$AUTH_PASSWORD" ]] || return 1
  SAVED_NAME="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("name") or "")' "$STATE_FILE")"
  SAVED_PORT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("port") or "")' "$STATE_FILE")"
  SAVED_DOMAIN="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("domain") or "")' "$STATE_FILE")"
  SAVED_SNI="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("sni") or "")' "$STATE_FILE")"
  SAVED_EMAIL="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("acme_email") or "")' "$STATE_FILE")"
  SAVED_TLS_MODE="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("tls_mode") or "")' "$STATE_FILE")"
  SAVED_TLS_CERT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("tls_cert") or "")' "$STATE_FILE")"
  SAVED_TLS_KEY="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("tls_key") or "")' "$STATE_FILE")"
  [[ -n "$SAVED_NAME" && -n "$SAVED_DOMAIN" ]] || return 1
  return 0
}

require_hy2_installed() {
  if [[ ! -f "$STATE_FILE" || ! -f "$CONFIG_FILE" ]]; then
    die "未检测到本脚本安装的节点（缺少 ${PREFIX} 下的配置或状态文件）。换端口只能用于已安装实例，请先完成安装。"
  fi
  if ! load_existing_identity; then
    die "状态文件不完整，已拒绝换端口，以免生成新密码或触发证书申请。"
  fi
  NODE_NAME="$SAVED_NAME"
  DOMAIN="$SAVED_DOMAIN"
  SNI="${SAVED_SNI:-$DOMAIN}"
  ACME_EMAIL="${SAVED_EMAIL:-hy2-acme@${DOMAIN}}"
  TLS_MODE="${SAVED_TLS_MODE:-acme}"
  TLS_CERT="${SAVED_TLS_CERT:-}"
  TLS_KEY="${SAVED_TLS_KEY:-}"
  OLD_PORT="${SAVED_PORT:-}"
  local cfg_port=''
  if cfg_port="$(read_config_listen_port "$CONFIG_FILE")"; then
    if [[ -n "$OLD_PORT" && "$cfg_port" != "$OLD_PORT" ]]; then
      warn "状态文件中的端口（${OLD_PORT}）与配置监听端口（${cfg_port}）不一致，将以配置为准。"
    fi
    OLD_PORT="$cfg_port"
  fi
  valid_port "${OLD_PORT:-}" || die "无法确定当前 UDP 端口。"
  if [[ $SANDBOX -eq 0 ]]; then
    [[ -x "$BIN_DIR/hysteria" ]] || die "未找到本脚本的官方二进制 ${BIN_DIR}/hysteria，已拒绝继续。"
    [[ -f "$UNIT_PATH" ]] || die "未找到服务单元 ${UNIT_PATH}，已拒绝继续，以免误操作其他服务。"
    if ! grep -F "${BIN_DIR}/hysteria" "$UNIT_PATH" >/dev/null 2>&1 \
      || ! grep -F "${CONFIG_FILE}" "$UNIT_PATH" >/dev/null 2>&1; then
      die "系统单元 ${UNIT_PATH} 不属于本脚本安装，已拒绝修改。"
    fi
  fi
}

prompt_change_port() {
  local raw="${REQUESTED_PORT:-}"
  if [[ -z "$raw" && -n "${HY2_NODE_PORT:-}" ]]; then
    raw="${HY2_NODE_PORT}"
  fi
  if [[ -z "$raw" ]]; then
    if [[ $ASSUME_YES -eq 1 ]]; then
      die "非交互换端口需要提供新端口：sudo bash ${SCRIPT_NAME} --change-port 443"
    fi
    if [[ ! -t 0 ]]; then
      die "没有终端可询问新端口。请使用：sudo bash ${SCRIPT_NAME} --change-port <端口>"
    fi
    printf '当前 UDP 端口是 %s。请输入新端口（推荐 443）：' "$OLD_PORT" >&2
    read -r raw
  fi
  raw="$(printf '%s' "$raw" | awk '{$1=$1; print}')"
  valid_port "$raw" || die "端口无效：${raw:-空}"
  PORT="$raw"
}

maybe_open_new_udp_port() {
  local mode
  # 换端口时即使加了 --yes，本机放行仍须明确确认（除非预先设置 HY2_NODE_OPEN_PORT）
  if [[ -n "${OPEN_PORT_MODE}" ]]; then
    mode="$(maybe_prompt_mode "${OPEN_PORT_MODE}")"
  elif [[ -t 0 ]]; then
    mode='ask'
  else
    mode='no'
  fi
  info "如需本机放行新端口，只会新增 UDP ${PORT} 规则，不会删除旧端口 UDP ${OLD_PORT} 的规则（可能仍被其他服务使用）。不会改动 TCP 80 证书挑战端口。云厂商安全组请自行放行新的 UDP ${PORT}，并更新客户端订阅或重新导入链接。"
  case "$mode" in
    no|NO|0)
      info "已跳过本机防火墙写入。请自行放行 UDP ${PORT}，并检查云安全组。"
      return 0
      ;;
    yes|YES|1)
      ;;
    ask|ASK)
      if confirm "是否仅新增放行本机 UDP ${PORT}（不删旧规则、不改默认策略和 SSH、不改 TCP 80）？"; then
        mode='yes'
      else
        info "已跳过本机端口放行。请记得在云安全组放行 UDP ${PORT}。"
        return 0
      fi
      ;;
    *) die "HY2_NODE_OPEN_PORT 只能是 yes、no 或 ask。" ;;
  esac
  if [[ $SANDBOX -eq 1 ]]; then
    info "沙箱模式：不修改防火墙。"
    return 0
  fi
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
    ufw allow "${PORT}/udp" comment 'hy2-node' || die "ufw 放行 UDP 失败。"
    info "已通过 ufw 新增 UDP ${PORT}。未删除旧端口规则。"
    return 0
  fi
  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -q running; then
    firewall-cmd --permanent --add-port="${PORT}/udp" || die "firewalld 放行 UDP 失败。"
    firewall-cmd --reload || true
    info "已通过 firewalld 新增 UDP ${PORT}。未删除旧端口规则。"
    return 0
  fi
  warn "未检测到已启用的 ufw 或 firewalld。本脚本不会擅自改 iptables/nft。请自行放行 UDP ${PORT}，并检查云防火墙/安全组。"
}

restart_our_service_after_port_change() {
  local was_active="${PREV_UNIT_ACTIVE}"
  if ! systemctl restart "$UNIT_NAME"; then
    err "换端口后服务重启失败，不会停止其他服务。正在恢复旧配置。"
    systemctl status "$UNIT_NAME" --no-pager -l || true
    journalctl -u "$UNIT_NAME" -n 80 --no-pager || true
    rollback_install
    if [[ "$was_active" == "active" ]]; then
      systemctl start "$UNIT_NAME" >/dev/null 2>&1 || true
    fi
    die "已恢复原来的端口、配置和客户端链接。"
  fi
  SERVICE_STARTED_THIS_RUN=1
  if ! wait_service_ready; then
    rollback_install
    if [[ "$was_active" == "active" ]]; then
      systemctl start "$UNIT_NAME" >/dev/null 2>&1 || true
    fi
    die "服务未能在新端口就绪，已恢复原来的端口、配置和客户端链接。"
  fi
  info "服务 ${UNIT_NAME} 已在 UDP ${PORT} 上运行。证书与 ACME 状态未改动。"
}

run_change_port() {
  if [[ $SANDBOX -eq 0 ]]; then
    if [[ "$(id -u)" != "0" ]]; then
      die "换端口需要 root。请使用：sudo bash ${SCRIPT_NAME} --change-port [端口]"
    fi
    os_supported || die "仅支持 Debian 或 Ubuntu（当前：$(os_id:-未知)）。"
    have_systemd || die "需要 systemd。"
  fi
  init_paths
  if [[ $SANDBOX -eq 0 ]]; then
    command -v python3 >/dev/null 2>&1 || die "缺少命令：python3。"
    if ! command -v ss >/dev/null 2>&1 && ! command -v lsof >/dev/null 2>&1; then
      die "需要 ss 或 lsof 才能检查端口占用。"
    fi
  fi
  require_hy2_installed
  if have_systemd && [[ $SANDBOX -eq 0 ]]; then
    info "当前服务 ${UNIT_NAME} 状态：$(systemctl is-active "$UNIT_NAME" 2>/dev/null || true)（enabled=$(systemctl is-enabled "$UNIT_NAME" 2>/dev/null || true)）"
  fi
  prompt_change_port
  if [[ "$PORT" == "$OLD_PORT" ]]; then
    info "当前已经是 UDP ${PORT}，无需修改。"
    return 0
  fi
  assert_udp_port_free "$PORT"
  info "将把 UDP 端口从 ${OLD_PORT} 改为 ${PORT}。会保留密码、域名、SNI、节点名称和证书/ACME 状态，不会重新申请证书，也不会下载或升级二进制。"
  mkdir -p "$ETC_DIR"
  prepare_rollback_snapshots
  export_runtime_env
  write_server_config
  assert_config_policy "$CONFIG_FILE" || { rollback_install; die "新端口配置不符合既定策略，已恢复。"; }
  write_client_files
  save_state
  if [[ $SANDBOX -eq 1 ]]; then
    info "沙箱模式：已写入新端口的配置与客户端文件，未重启系统服务，也未改防火墙。"
    return 0
  fi
  restart_our_service_after_port_change
  fix_permissions
  maybe_open_new_udp_port
  info "换端口完成：${OLD_PORT}/udp -> ${PORT}/udp。显示名：${NODE_NAME}；证书与 SNI 仍是 ${SNI}。"
  info "更新后的客户端 URI：${LINK_FILE}；Mihomo 片段：${MIHOMO_FILE}"
  info "请更新客户端订阅或重新导入链接。云安全组需放行新的 UDP ${PORT}。旧端口规则未删除。"
  if [[ -t 1 ]]; then
    echo "----- 新的客户端 URI（请当凭据保管） -----"
    cat "$LINK_FILE"
    echo
  fi
}

