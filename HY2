verify_domain_points_to_this_host() {
  local domain="$1"
  local local_ips resolved
  local_ips="$(collect_local_ips || true)"
  if [[ -z "$local_ips" ]]; then
    die "无法确定本机 IPv4/IPv6 地址，已中止。请确认网卡地址或出口地址可见。"
  fi
  set +e
  resolved="$(resolve_domain_ips "$domain")"
  local rc=$?
  set -e
  if [[ $rc -ne 0 || -z "$resolved" ]]; then
    die "域名 ${domain} 无法解析到 A/AAAA 记录。"
  fi
  local check_out check_rc
  set +e
  check_out="$(python3 - "$domain" "$local_ips" "$resolved" <<'PYCODE'
import ipaddress,sys
domain, local_raw, resolved_raw = sys.argv[1], sys.argv[2], sys.argv[3]
local=set()
for line in local_raw.splitlines():
    line=line.strip()
    if not line: continue
    local.add(ipaddress.ip_address(line))
resolved=[]
for line in resolved_raw.splitlines():
    line=line.strip()
    if not line: continue
    resolved.append(ipaddress.ip_address(line))
if not resolved:
    print("域名没有解析结果", file=sys.stderr)
    sys.exit(2)
bad=[]
for ip in resolved:
    if ip not in local:
        bad.append(str(ip))
if bad:
    print("UNMATCH %s" % ",".join(bad))
    sys.exit(3)
v4=[str(i) for i in resolved if i.version==4]
v6=[str(i) for i in resolved if i.version==6]
print("OK v4=%s v6=%s" % (",".join(v4) or "-", ",".join(v6) or "-"))
PYCODE
)"
  check_rc=$?
  set -e
  if [[ $check_rc -eq 0 ]]; then
    info "域名 ${domain} 的解析已指向本机（${check_out}），将使用该域名作为证书名与 SNI。不会改用或伪造其他域名。"
    return 0
  fi
  local unmatched
  unmatched="$(python3 - "$local_ips" "$resolved" <<'PYCODE'
import ipaddress,sys
local=set(ipaddress.ip_address(x) for x in sys.argv[1].split() if x)
bad=[]
for line in sys.argv[2].splitlines():
    line=line.strip()
    if not line: continue
    ip=ipaddress.ip_address(line)
    if ip not in local:
        bad.append(str(ip))
print(",".join(bad))
PYCODE
)"
  local cf
  cf="$(cf_reason_if_any "$unmatched")"
  err "域名 ${domain} 解析到的地址未指向当前 VPS：${unmatched}"
  err "本机可见地址："
  printf '%s\n' "$local_ips" | sed 's/^/  /' >&2
  if [[ "$cf" == "yes" ]]; then
    err "解析结果落在 Cloudflare 地址段内。官方明确 Hysteria 不能走 CDN/普通橙云；请把该域名改为仅 DNS（关闭代理）并指向本机 IP，没有绕过方法。"
  fi
  die "解析不匹配，已中止，不会继续申请证书或启动服务。"
}

# ---------------------------------------------------------------------------
# 已有证书校验（必须可被系统根信任，且覆盖指定域名）
# ---------------------------------------------------------------------------
verify_existing_certificate() {
  local cert="$1" key="$2" domain="$3"
  _cert_fail() { err "$1"; return 1; }
  [[ -f "$cert" && -r "$cert" ]] || { _cert_fail "找不到或无法读取证书：$cert"; return 1; }
  [[ -f "$key" && -r "$key" ]] || { _cert_fail "找不到或无法读取私钥：$key"; return 1; }
  openssl x509 -in "$cert" -noout >/dev/null 2>&1 || { _cert_fail "证书文件不是有效的 PEM 证书。"; return 1; }
  openssl pkey -in "$key" -noout >/dev/null 2>&1 || { _cert_fail "私钥文件无法解析。"; return 1; }
  if ! openssl x509 -in "$cert" -noout -checkend 86400 >/dev/null 2>&1; then
    _cert_fail "证书已过期或将在 24 小时内过期，拒绝使用。"
    return 1
  fi
  if ! python3 - "$cert" "$domain" <<'PYCODE'
import subprocess,sys,re
cert,domain=sys.argv[1],sys.argv[2].lower().rstrip('.')
out=subprocess.check_output(["openssl","x509","-in",cert,"-noout","-text"], text=True, errors="replace")
names=set()
block=re.search(r"Subject Alternative Name:\s*\n\s*(.*)", out)
if block:
    for part in block.group(1).split(","):
        part=part.strip()
        m=re.match(r"DNS:(\S+)", part)
        if m:
            names.add(m.group(1).rstrip('.').lower())
m=re.search(r"Subject:.*\bCN\s*=\s*([^,\n/]+)", out)
if m:
    names.add(m.group(1).strip().rstrip('.').lower())

def covers(pattern, host):
    if pattern==host:
        return True
    if pattern.startswith("*."):
        suffix=pattern[2:]
        return host.endswith("."+suffix) and host.count(".")==suffix.count(".")+1
    return False
if not any(covers(n, domain) for n in names):
    sys.stderr.write("证书未覆盖域名 %s；证书名：%s\n" % (domain, ", ".join(sorted(names)) or "(无)"))
    sys.exit(2)
print("san ok")
PYCODE
  then
    return 1
  fi
  local ca='/etc/ssl/certs/ca-certificates.crt'
  if [[ ! -f "$ca" ]]; then
    ca='/etc/ssl/cert.pem'
  fi
  local verify_ok=0
  if [[ -f "$ca" ]]; then
    openssl verify -CAfile "$ca" "$cert" >/dev/null 2>&1 && verify_ok=1
  else
    openssl verify "$cert" >/dev/null 2>&1 && verify_ok=1
  fi
  if [[ $verify_ok -ne 1 ]]; then
    err "证书未通过系统根证书校验。本脚本默认不使用自签，也不提供跳过校验。"
    return 1
  fi
  local pub1 pub2
  pub1="$(openssl x509 -noout -pubkey -in "$cert" 2>/dev/null | openssl md5 | awk '{print $NF}')"
  pub2="$(openssl pkey -in "$key" -pubout 2>/dev/null | openssl md5 | awk '{print $NF}')"
  if [[ -n "$pub1" && -n "$pub2" && "$pub1" != "$pub2" ]]; then
    err "证书与私钥不匹配。"
    return 1
  fi
  info "已有证书通过信任校验，并且覆盖域名 ${domain}。"
}


# ---------------------------------------------------------------------------
