#!/usr/bin/env bash
# 独立部署官方 Hysteria 2 单节点（不安装 3x-ui 或其他面板）。
# 固定官方版本：Hysteria 2.14.0（release 标签 app/v2.14.0），不会静默改用 latest。
# 仅本脚本被授权制作；不会改 SSH、全局防火墙策略，也不会部署到未被指定的机器。
set -euo pipefail

# ---------------------------------------------------------------------------
# 固定版本与官方校验和（来自 GitHub Releases 的 hashes.txt，不是供应链签名认证）
# 仓库已由 apernet/hysteria 更名为 HyNetworks/hysteria，二者指向同一官方仓库。
# ---------------------------------------------------------------------------
readonly HY2_VERSION='2.14.0'
readonly HY2_RELEASE_TAG='app/v2.14.0'
readonly GITHUB_REPO='HyNetworks/hysteria'
readonly DEFAULT_RELEASE_BASE="https://github.com/${GITHUB_REPO}/releases/download/${HY2_RELEASE_TAG}"

# 官方 hashes.txt（app/v2.14.0，2026-11-15）中对应 linux 二进制的 SHA256
readonly PINNED_SHA256_LINUX_AMD64='fc25edff9948708cb00a4ff01f3bccde677660aca050133bb1ad46c6860362d2'
readonly PINNED_SHA256_LINUX_ARM64='e7c52241299fe85aba11e9d36e85d8d88ddbb5799ac0e33d272219d20e313bab'
readonly HASHES_FILE_NAME='hashes.txt'

readonly SCRIPT_NAME='install-hy2-node.sh'
readonly SCRIPT_VERSION='1.1.0'
readonly UNIT_NAME='hy2-node.service'
readonly DEFAULT_PREFIX='/opt/hy2-node'
readonly SYSUSER='hy2-node'
readonly UDP_BUF_MIN='16777216'
readonly NAME_PREFIX='HY2-'

# ---------------------------------------------------------------------------
# 全局状态
# ---------------------------------------------------------------------------
