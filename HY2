}

load_or_create_identity() {
  local loaded=0
  if [[ -f "$STATE_FILE" ]]; then
    AUTH_PASSWORD="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("password") or "")' "$STATE_FILE")"
    if [[ -n "$AUTH_PASSWORD" ]]; then
      loaded=1
      SAVED_NAME="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("name") or "")' "$STATE_FILE")"
      SAVED_PORT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("port") or "")' "$STATE_FILE")"
      SAVED_DOMAIN="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("domain") or "")' "$STATE_FILE")"
      SAVED_SNI="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("sni") or "")' "$STATE_FILE")"
      SAVED_EMAIL="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("acme_email") or "")' "$STATE_FILE")"
      SAVED_TLS_MODE="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("tls_mode") or "")' "$STATE_FILE")"
      SAVED_TLS_CERT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("tls_cert") or "")' "$STATE_FILE")"
      SAVED_TLS_KEY="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8")).get("tls_key") or "")' "$STATE_FILE")"
      : "${SAVED_SNI:-}" "${SAVED_TLS_MODE:-}" "${SAVED_TLS_CERT:-}" "${SAVED_TLS_KEY:-}"
      info "已检测到既有身份，将保留认证密码，不会无谓重新申请证书。"
    fi
  fi
  if [[ $loaded -eq 0 ]]; then
    AUTH_PASSWORD="$(generate_password)"
    info "已生成随机强认证密码（只写入受限文件，不会在日志里打印）。"
  fi
}

build_share_uri() {
  python3 - <<'PYCODE'
import os,urllib.parse
host=os.environ["DOMAIN"]
port=os.environ["PORT"]
password=os.environ["AUTH_PASSWORD"]
sni=os.environ["SNI"]
name=os.environ["NODE_NAME"]
user=urllib.parse.quote(password, safe="")
q=urllib.parse.urlencode({"sni": sni, "alpn": "h3"}, quote_via=urllib.parse.quote, safe="")
frag=urllib.parse.quote(name, safe="")
