with_secrets_quiet() {
  local xtrace_was=0
  case "$-" in *x*) xtrace_was=1; set +x ;; esac
  "$@"
  local rc=$?
  if [[ $xtrace_was -eq 1 ]]; then set -x; fi
  return "$rc"
}

usage() {
  cat <<EOF
${SCRIPT_NAME} ${SCRIPT_VERSION}
在 Debian / Ubuntu（systemd，amd64 或 arm64）上安装固定版本官方 Hysteria 2（${HY2_VERSION}），
部署无面板单节点。需要你自己的域名，且解析到本机公网 IPv4/IPv6；使用官方内置 ACME
（Let’s Encrypt，HTTP-01 / TCP 80）申请并自动续期。默认正常校验证书，不使用自签，
也不在客户端默认跳过校验。不会覆盖已有 3x-ui / Xray / 官方 hysteria-server。

用法:
  sudo bash ${SCRIPT_NAME}                 交互安装（需 root）
  sudo bash ${SCRIPT_NAME} --yes           非交互：需已通过环境变量提供名称和域名；端口未指定时用推荐的 443
  sudo bash ${SCRIPT_NAME} --change-port [端口]
                                           给已安装节点更换 UDP 端口（不必重装或重签证书；无端口则交互询问）
  bash ${SCRIPT_NAME} --self-test          本地自检（不安装系统服务、不开端口、不改防火墙/sysctl）
  bash ${SCRIPT_NAME} --help

端口由你填写或确认，不会随机生成，也没有端口跳跃。新安装默认推荐 443/UDP，允许自定义；
不能认为高端口一定会被封。换端口只会改本脚本自己的服务配置与客户端链接。

常用环境变量:
  HY2_NODE_NAME             节点名称（会统一加上 ${NAME_PREFIX} 前缀；已带此前缀则不重复）
  HY2_NODE_PORT             UDP 监听端口
  HY2_NODE_DOMAIN           已解析到本机的自有域名（用作证书与 SNI，不会伪造大厂域名）
  HY2_NODE_ACME_EMAIL       ACME 账户邮箱（可选；默认 hy2-acme@域名，仅用于 CA 通知）
  HY2_NODE_TLS_CERT         已有证书路径（当 TCP 80 被占用、无法做 HTTP-01 时可选）
  HY2_NODE_TLS_KEY          已有证书私钥路径
  HY2_NODE_OPEN_PORT=yes|no|ask    是否放行本机最小 UDP 端口（默认：有终端则 ask，否则 no）
  HY2_NODE_SYSCTL=yes|no|ask       是否写入 UDP 缓冲上限两项 sysctl（默认同上）
  HY2_NODE_INSTALL_DEPS=yes|no|ask 缺失依赖时是否 apt 安装（默认同上；未确认则不装）
  HY2_NODE_RELEASE_BASE     官方 release 下载前缀（仍校验钉死哈希；默认 GitHub）
  HY2_NODE_PREFIX           安装目录（默认 ${DEFAULT_PREFIX}）

一条命令远程安装：当前没有可公开托管地址，请勿编造 curl 网址。把本脚本放到你信任的
HTTPS 位置并核对后再执行。不要使用来历不明的一键链接。不要改成 latest 版本。

${HY2_VERSION} 按官方稳定 release 钉死，不是浮动的 latest。
官方校验核对本版本 hashes.txt 中的 SHA256 与脚本内钉死哈希；这不是签名或供应链认证。
EOF
}

need_cmd() {
  local c
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || die "缺少命令：$c。请先安装后再运行。"
  done
}

os_id() {
  local id=''
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    id="$(. /etc/os-release && printf '%s' "${ID:-}")"
  fi
  printf '%s' "$id"
}

os_supported() {
  case "$(os_id)" in
    debian|ubuntu) return 0 ;;
    *) return 1 ;;
  esac
}

have_systemd() {
  command -v systemctl >/dev/null 2>&1 || return 1
  [[ -d /run/systemd/system ]] || return 1
}

detect_asset() {
  local m
  m="$(uname -m)"
  case "$m" in
    x86_64|amd64)
      ASSET_BIN='hysteria-linux-amd64'
      ASSET_HASH_NAME='build/hysteria-linux-amd64'
      PINNED_SHA256="$PINNED_SHA256_LINUX_AMD64"
      ;;
    aarch64|arm64)
      ASSET_BIN='hysteria-linux-arm64'
      ASSET_HASH_NAME='build/hysteria-linux-arm64'
      PINNED_SHA256="$PINNED_SHA256_LINUX_ARM64"
      ;;
    *)
      die "不支持的架构：$m。仅支持 amd64（x86_64）与 arm64（aarch64）。"
      ;;
  esac
}

init_paths() {
  BIN_DIR="${PREFIX}/bin"
  ETC_DIR="${PREFIX}/etc"
  VAR_DIR="${PREFIX}/var"
  LOG_DIR="${PREFIX}/log"
  ACME_DIR="${VAR_DIR}/acme"
  STATE_FILE="${ETC_DIR}/state.json"
  CONFIG_FILE="${ETC_DIR}/config.yaml"
  LINK_FILE="${ETC_DIR}/client-uri.txt"
  MIHOMO_FILE="${ETC_DIR}/mihomo.yaml"
  if [[ $SANDBOX -eq 1 ]]; then
    UNIT_PATH="${PREFIX}/hy2-node.service"
    SYSCTL_FILE="${PREFIX}/99-hy2-node.conf"
  fi
}

urlencode() {
  python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

valid_port() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  ((10#$p >= 1 && 10#$p <= 65535))
}

# 输入优先；否则保留已保存端口；新装未指定时用推荐的 443。不会随机生成。
resolve_listen_port() {
  local input="$1" saved="$2"
  if [[ -n "$input" ]]; then
    printf '%s' "$input"
    return 0
  fi
  if [[ -n "$saved" ]]; then
    printf '%s' "$saved"
    return 0
  fi
  printf '443'
}

valid_domain() {
  python3 - "$1" <<'PYCODE'
import sys,re
d=sys.argv[1].strip().rstrip('.').lower()
if not d or d.endswith('.local') or d in ('localhost',):
    sys.exit(1)
if re.fullmatch(r'\d{1,3}(?:\.\d{1,3}){3}', d):
    sys.exit(1)
if ':' in d:
    sys.exit(1)
if not re.fullmatch(r'[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(?:\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+', d):
    sys.exit(1)
if len(d) > 253:
    sys.exit(1)
print(d)
PYCODE
}

normalize_node_name() {
  python3 - "$1" "${NAME_PREFIX}" <<'PYCODE'
import sys
raw=(sys.argv[1] or "").strip()
prefix=sys.argv[2]
if not raw:
    sys.exit(2)
if raw.startswith(prefix):
    name=raw
else:
    name=prefix+raw
rest=name[len(prefix):]
if not rest or rest.strip()=="":
    sys.exit(3)
if "\n" in name or "\r" in name:
    sys.exit(4)
if len(name) > 128:
    sys.exit(5)
print(name)
PYCODE
}

sha256_of() {
  sha256sum "$1" | awk '{print $1}'
}

parse_hashes_sha256() {
  local hashes_file="$1" asset_name="$2"
  python3 - "$hashes_file" "$asset_name" <<'PYCODE'
import sys
path, name = sys.argv[1], sys.argv[2]
want=None
for line in open(path, encoding="utf-8", errors="replace"):
    line=line.strip()
    if not line or line.startswith("#"):
        continue
    parts=line.split()
    if len(parts) >= 2 and parts[-1] in (name, name.lstrip("./")):
        h=parts[0].lower()
        if len(h)==64 and all(c in "0123456789abcdef" for c in h):
            want=h
            break
if not want:
    sys.exit("无法从官方 hashes.txt 解析 %s 的 SHA256" % name)
print(want)
PYCODE
}

confirm() {
  local prompt="$1" ans
  if [[ $ASSUME_YES -eq 1 ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    return 1
  fi
  printf '%s [y/N] ' "$prompt" >&2
  read -r ans || return 1
  case "$ans" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

generate_password() {
  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
}

debian_packages_for_missing() {
  local missing_cmds="$1"
  local pkgs=()
  [[ "$missing_cmds" == *"curl"* ]] && pkgs+=(curl)
  [[ "$missing_cmds" == *"python3"* ]] && pkgs+=(python3)
  [[ "$missing_cmds" == *"openssl"* ]] && pkgs+=(openssl)
  [[ "$missing_cmds" == *"sha256sum"* ]] && pkgs+=(coreutils)
  if ! command -v ss >/dev/null 2>&1 && ! command -v lsof >/dev/null 2>&1; then
    pkgs+=(iproute2)
  fi
  if ! command -v ip >/dev/null 2>&1; then
    pkgs+=(iproute2)
  fi
  if [[ ! -e /etc/ssl/certs/ca-certificates.crt ]]; then
    pkgs+=(ca-certificates)
  fi
  if [[ ${#pkgs[@]} -eq 0 ]]; then
    return 0
  fi
  printf '%s\n' "${pkgs[@]}" | awk 'NF && !seen[$0]++'
}

ensure_dependencies() {
  local missing=() cmd
  for cmd in curl python3 sha256sum openssl; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  if ! command -v ss >/dev/null 2>&1 && ! command -v lsof >/dev/null 2>&1; then
    missing+=("ss或lsof")
  fi
  if ! command -v ip >/dev/null 2>&1; then
    missing+=("ip")
  fi
  if [[ ${#missing[@]} -eq 0 ]]; then
    return 0
  fi
  err "缺少命令：${missing[*]}。"
  local pkgs
  pkgs="$(debian_packages_for_missing "${missing[*]}")"
  if [[ -z "$pkgs" ]]; then
    die "请先安装缺失命令后再运行。"
  fi
  local pkg_line
  pkg_line="$(printf '%s' "$pkgs" | tr '\n' ' ')"
  info "可一次补齐（Debian/Ubuntu）：apt-get update && apt-get install -y ${pkg_line}"
  local mode="${INSTALL_DEPS_MODE}"
  if [[ -z "$mode" ]]; then
    if [[ $ASSUME_YES -eq 1 ]]; then
      mode='yes'
    elif [[ -t 0 ]]; then
      mode='ask'
    else
      mode='no'
    fi
  fi
  case "$mode" in
    no|NO|0)
      die "未确认安装依赖，已中止。请先执行上面的 apt 命令后重试。"
      ;;
    yes|YES|1)
      ;;
    ask|ASK)
      if confirm "是否现在用 apt 安装这些依赖（${pkg_line}）？未确认则不会安装。"; then
        mode='yes'
      else
        die "未确认安装依赖，已中止。请先执行：apt-get update && apt-get install -y ${pkg_line}"
      fi
      ;;
    *) die "HY2_NODE_INSTALL_DEPS 只能是 yes、no 或 ask。" ;;
  esac
  if [[ "$(id -u)" != "0" ]]; then
    die "安装依赖需要 root。请先手动执行：apt-get update && apt-get install -y ${pkg_line}"
  fi
  if [[ $SANDBOX -eq 1 || $SKIP_SYSTEMD -eq 1 ]]; then
    die "当前为沙箱/自检模式，不会在本机 apt 安装软件包。请换到目标 VPS 或先自行安装依赖。"
  fi
  apt-get update
  # shellcheck disable=SC2086
  apt-get install -y $pkgs
  for cmd in curl python3 sha256sum openssl ip; do
    command -v "$cmd" >/dev/null 2>&1 || die "依赖安装后仍缺少：$cmd"
  done
  if ! command -v ss >/dev/null 2>&1 && ! command -v lsof >/dev/null 2>&1; then
    die "依赖安装后仍缺少 ss 或 lsof。"
  fi
}

diagnose_curl() {
  local url="$1" code="$2" curl_rc="$3"
  err "下载失败：$url"
  err "curl 退出码：${curl_rc}，HTTP 状态：${code:-无}"
  case "$curl_rc" in
    6)  err "诊断：无法解析主机名，请检查 DNS 或到 GitHub 的网络。" ;;
    7)  err "诊断：连不上服务器，请检查出口网络、代理或防火墙。" ;;
    28) err "诊断：连接或传输超时。" ;;
    35) err "诊断：TLS 握手失败，请检查系统时间与证书。" ;;
    22|0)
      if [[ -n "$code" && "$code" != "200" ]]; then
        err "诊断：HTTP ${code}。若是 404，请确认版本 ${HY2_VERSION}（${HY2_RELEASE_TAG}）的资源名未写错；本脚本不会改下最新版。"
      fi
      ;;
    *)  err "诊断：请根据 curl 退出码检查网络。本脚本只从固定地址拉取 ${HY2_VERSION}。" ;;
  esac
  info "如 GitHub 不可达，可设置 HY2_NODE_RELEASE_BASE 指向你镜像的同类路径，但仍会校验官方哈希。"
}

download_file() {
  local url="$1" dest="$2"
  local tmp code rc
  tmp="${dest}.part"
  set +e
  code="$(curl -fsSL --connect-timeout 20 --max-time 300 -A "hy2-node-installer/${SCRIPT_VERSION}" \
    -o "$tmp" -w '%{http_code}' "$url")"
  rc=$?
  set -e
  if [[ $rc -ne 0 || "$code" != "200" ]]; then
    diagnose_curl "$url" "$code" "$rc"
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$dest"
}

download_and_verify_binary() {
  local work="$1"
  local bin_path="${work}/${ASSET_BIN}"
  local hashes_path="${work}/${HASHES_FILE_NAME}"
  local url_bin="${RELEASE_BASE}/${ASSET_BIN}"
  local url_hashes="${RELEASE_BASE}/${HASHES_FILE_NAME}"
  info "下载官方 Hysteria ${HY2_VERSION}：${ASSET_BIN}"
  download_file "$url_hashes" "$hashes_path" || die "无法下载官方 hashes.txt。"
  download_file "$url_bin" "$bin_path" || die "无法下载官方二进制。"
  local official_sha file_sha
  official_sha="$(parse_hashes_sha256 "$hashes_path" "$ASSET_HASH_NAME")"
  file_sha="$(sha256_of "$bin_path")"
  if [[ "$official_sha" != "$PINNED_SHA256" ]]; then
    die "官方 hashes.txt 中的 SHA256（${official_sha}）与脚本钉死的哈希（${PINNED_SHA256}）不一致。已中止，既不会改用最新版，也不会忽略校验。"
  fi
  if [[ "$file_sha" != "$official_sha" ]]; then
    rm -f "$bin_path"
    die "二进制 SHA256（${file_sha}）与官方 hashes.txt（${official_sha}）不一致，已删除并中止。这只是哈希校验，不是签名认证。"
  fi
  chmod 0755 "$bin_path"
  info "校验通过：官方 hashes.txt SHA256 与钉死哈希一致。这不是供应链签名认证。"
  printf '%s' "$bin_path"
}

verify_binary_version() {
  local bin="$1" out
  out="$("$bin" version 2>&1 || true)"
  if ! printf '%s\n' "$out" | grep -Eq "(^|[[:space:]vV])${HY2_VERSION}([[:space:]]|$)"; then
    err "二进制 version 输出未包含钉死版本 ${HY2_VERSION}："
    err "$out"
    return 1
  fi
  return 0
}

