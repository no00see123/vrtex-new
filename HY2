# ---------------------------------------------------------------------------
# 域名解析、本机地址、Cloudflare 橙云检测
# ---------------------------------------------------------------------------
collect_local_ips() {
  python3 - <<'PYCODE'
import os,re,socket,subprocess,ipaddress,shutil

def run(cmd, timeout=8):
    try:
        p=subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=timeout)
        return p.stdout
    except Exception:
        return ""

ips=set()
if shutil.which("ip"):
    out=run(["ip", "-o", "addr", "show"])
    for m in re.finditer(r"inet6?\s+([0-9a-fA-F:.]+)/\d+", out):
        try:
            ip=ipaddress.ip_address(m.group(1).split("%")[0])
        except ValueError:
            continue
        if ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_unspecified:
            continue
        ips.add(str(ip))

# 补充探测出口公网地址（失败则忽略，不作为绕过条件）
for args in (
    ["curl","-4","-fsS","--connect-timeout","3","--max-time","5","https://api.ipify.org"],
    ["curl","-6","-fsS","--connect-timeout","3","--max-time","5","https://api64.ipify.org"],
):
    if not shutil.which("curl"):
        break
    out=run(args, timeout=6).strip()
    try:
        ip=ipaddress.ip_address(out)
    except ValueError:
        continue
    if not (ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_unspecified):
        ips.add(str(ip))

for ip in sorted(ips, key=lambda x: (":" in x, x)):
    print(ip)
PYCODE
}

resolve_domain_ips() {
  python3 - "$1" <<'PYCODE'
import sys,socket
domain=sys.argv[1]
found=set()
for family, typ, proto, canon, sockaddr in socket.getaddrinfo(domain, None, type=socket.SOCK_STREAM):
    ip=sockaddr[0]
    found.add(ip)
if not found:
    sys.exit(2)
for ip in sorted(found, key=lambda x: (":" in x, x)):
    print(ip)
PYCODE
}

