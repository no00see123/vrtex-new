    NODE_NAME='HY2-selftest'
    PORT='40111'
    DOMAIN='127.0.0.1.nip.io'
    # 上面域名不会在此启动 ACME；改用 existing 仅用于加载测试
    DOMAIN='example.com'
    SNI='example.com'
    ACME_EMAIL='hy2-acme@example.com'
    TLS_MODE='existing'
    TLS_CERT="$live/c.pem"
    TLS_KEY="$live/k.pem"
    export_runtime_env
    write_server_config
    # 把 listen 改到高位地址，避免需要特权端口
    python3 - "$CONFIG_FILE" <<'PYCODE'
import sys
p=sys.argv[1]
t=open(p,encoding="utf-8").read().replace("listen: :40111","listen: 127.0.0.1:40111")
open(p,"w",encoding="utf-8").write(t)
PYCODE
    local outf="${testdir}/hy2-run.log"
    set +e
    timeout 3 "$bin" server --config "$CONFIG_FILE" >"$outf" 2>&1
    local run_rc=$?
    set -e
    if grep -qiE 'invalid config|failed to load server config|unknown field' "$outf"; then
      err "官方程序拒绝了生成的配置："
      cat "$outf" >&2
      rc=1
    elif grep -qiE 'server up and running' "$outf"; then
      info "官方程序在沙箱中成功加载配置（临时证书仅用于解析/启动验证，不是默认安装路径）。"
    else
      # timeout 可能在成功启动后被终止，exit 124
      if grep -qiE 'listen|quic|tls|server' "$outf" && ! grep -qiE 'FATAL|invalid config' "$outf"; then
        info "官方程序已接受配置并开始运行（沙箱短超时结束）。日志未见配置错误。"
      else
        warn "未能明确看到启动成功日志，已保留输出；不把它说成官方配置测试命令。"
        cat "$outf" >&2 || true
        # 不因此把整个自检判死，除非明显是配置错误
        if [[ $run_rc -ne 0 && $run_rc -ne 124 ]]; then
          rc=1
        fi
      fi
    fi
  else
    warn "无法下载官方二进制，已跳过真实内核校验。语法与链接测试仍已执行。"
    rc=1
  fi

  if grep -nE 'printf .*\$.*(AUTH_PASSWORD|PRIVATE|tls_key)' "$0" | grep -v 'write_client_files\|save_state\|STATE_FILE\|# ' >/dev/null; then
    :
  fi

  if [[ $rc -eq 0 ]]; then
    info "自检通过。"
  else
    err "自检存在失败项。"
  fi
  return "$rc"
}

main() {
  local do_change=0
  REQUESTED_PORT="${REQUESTED_PORT:-}"
  if [[ $# -eq 0 ]]; then
    run_install
    return
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        usage
        return 0
        ;;
      --self-test)
        SANDBOX=1
        SKIP_SYSTEMD=1
        self_test
        return
        ;;
      --yes)
        ASSUME_YES=1
        shift
        ;;
      --sandbox)
        SANDBOX=1
        SKIP_SYSTEMD=1
        PREFIX="${2:-}"
        shift 2 || die "--sandbox 需要目录"
        ;;
      --change-port)
        do_change=1
        shift
        if [[ $# -gt 0 && "$1" != --* ]]; then
          REQUESTED_PORT="$1"
          shift
        fi
        ;;
      *)
        die "未知参数：$1。使用 --help 查看说明。"
        ;;
    esac
  done
  if [[ $do_change -eq 1 ]]; then
    run_change_port
  else
    run_install
  fi
}

if [[ "${HY2_NODE_ASSUME_YES:-}" == "1" ]]; then
  ASSUME_YES=1
fi

main "$@"
