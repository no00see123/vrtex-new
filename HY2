prompt_inputs() {
  local raw_name raw_port raw_domain raw_email
  if [[ -n "${HY2_NODE_NAME:-}" ]]; then
    raw_name="${HY2_NODE_NAME}"
  elif [[ $ASSUME_YES -eq 1 ]]; then
    die "非交互模式需要设置 HY2_NODE_NAME。"
  else
    if [[ -n "${SAVED_NAME:-}" ]]; then
      printf '节点名称（直接回车保留 %s）：' "$SAVED_NAME" >&2
    else
      printf '节点名称（将自动加上 HY2- 前缀；已带 HY2- 则不重复）：' >&2
    fi
    read -r raw_name
    if [[ -z "$raw_name" && -n "${SAVED_NAME:-}" ]]; then
      raw_name="$SAVED_NAME"
    fi
  fi
  if ! NODE_NAME="$(normalize_node_name "$raw_name")"; then
    die "节点名称无效。不能为空，且不能只写成 HY2-。"
  fi
  if [[ "$raw_name" == "${NAME_PREFIX}"* ]]; then
    info "节点名称已带 ${NAME_PREFIX} 前缀，保持为：${NODE_NAME}"
  else
    info "节点名称已统一为：${NODE_NAME}"
  fi

  if [[ -n "${HY2_NODE_PORT:-}" ]]; then
    raw_port="${HY2_NODE_PORT}"
  elif [[ $ASSUME_YES -eq 1 ]]; then
    raw_port="$(resolve_listen_port "" "${SAVED_PORT:-}")"
    if [[ -z "${SAVED_PORT:-}" ]]; then
      info "未指定端口，使用推荐的 443/UDP。"
    fi
  else
    if [[ -n "${SAVED_PORT:-}" ]]; then
      printf 'UDP 端口（直接回车保留 %s）：' "$SAVED_PORT" >&2
    else
      printf 'UDP 监听端口（推荐 443，直接回车使用 443）：' >&2
    fi
    read -r raw_port
    raw_port="$(resolve_listen_port "$raw_port" "${SAVED_PORT:-}")"
  fi
  valid_port "$raw_port" || die "端口无效：$raw_port"
  PORT="$raw_port"

  if [[ -n "${HY2_NODE_DOMAIN:-}" ]]; then
    raw_domain="${HY2_NODE_DOMAIN}"
  elif [[ $ASSUME_YES -eq 1 ]]; then
    die "非交互模式需要设置 HY2_NODE_DOMAIN（必须是已解析到本机的自有域名）。"
  else
    if [[ -n "${SAVED_DOMAIN:-}" ]]; then
      printf '域名（直接回车保留 %s）：' "$SAVED_DOMAIN" >&2
    else
      printf '已解析到本机的自有域名（将用作证书与 SNI，不会伪造大厂域名）：' >&2
    fi
    read -r raw_domain
    if [[ -z "$raw_domain" && -n "${SAVED_DOMAIN:-}" ]]; then
      raw_domain="$SAVED_DOMAIN"
    fi
  fi
  DOMAIN="$(valid_domain "$raw_domain")" || die "域名无效。请填写你自己的域名，并且不要使用 IP 地址。"
  SNI="$DOMAIN"

  if [[ -n "${HY2_NODE_ACME_EMAIL:-}" ]]; then
    ACME_EMAIL="${HY2_NODE_ACME_EMAIL}"
  elif [[ $ASSUME_YES -eq 1 ]]; then
    ACME_EMAIL="${SAVED_EMAIL:-hy2-acme@${DOMAIN}}"
  else
    if [[ -n "${SAVED_EMAIL:-}" ]]; then
      printf 'ACME 联系邮箱（直接回车保留已有值，仅用于证书到期通知）：' >&2
    else
      printf 'ACME 联系邮箱（直接回车则使用 hy2-acme@%s，仅用于 CA 通知，可稍后改配置）：' "$DOMAIN" >&2
    fi
    read -r raw_email
    if [[ -n "$raw_email" ]]; then
      ACME_EMAIL="$raw_email"
    elif [[ -n "${SAVED_EMAIL:-}" ]]; then
      ACME_EMAIL="$SAVED_EMAIL"
    else
      ACME_EMAIL="hy2-acme@${DOMAIN}"
    fi
  fi
  python3 -c 'import re,sys; s=sys.argv[1]; sys.exit(0 if re.fullmatch(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", s) else 1)' "$ACME_EMAIL" \
    || die "ACME 邮箱格式无效。"

  if [[ -n "${HY2_NODE_TLS_CERT:-}" || -n "${HY2_NODE_TLS_KEY:-}" ]]; then
    [[ -n "${HY2_NODE_TLS_CERT:-}" && -n "${HY2_NODE_TLS_KEY:-}" ]] || die "已有证书需同时提供 HY2_NODE_TLS_CERT 与 HY2_NODE_TLS_KEY。"
    TLS_MODE='existing'
    TLS_CERT="${HY2_NODE_TLS_CERT}"
    TLS_KEY="${HY2_NODE_TLS_KEY}"
  elif [[ $ASSUME_YES -eq 1 ]]; then
    TLS_MODE='acme'
  else
    TLS_MODE='acme'
  fi

  if [[ -n "${SAVED_DOMAIN:-}" && "$DOMAIN" != "${SAVED_DOMAIN}" && "$TLS_MODE" == "acme" ]]; then
    warn "域名已从 ${SAVED_DOMAIN} 改为 ${DOMAIN}。若使用 ACME，这会申请新证书，请注意 Let’s Encrypt 频率限制。"
  fi
}

export_runtime_env() {
  export NODE_NAME PORT DOMAIN SNI ACME_EMAIL TLS_MODE TLS_CERT TLS_KEY AUTH_PASSWORD ACME_DIR HY2_VERSION
}

# ---------------------------------------------------------------------------
# 安装流程
# ---------------------------------------------------------------------------
run_install() {
  if [[ $SANDBOX -eq 0 && $SKIP_SYSTEMD -eq 0 ]]; then
    [[ "$(id -u)" == "0" ]] || die "安装需要 root（请使用 sudo）。自检请用 --self-test。"
    os_supported || die "仅支持 Debian 或 Ubuntu（当前：$(os_id:-未知)）。"
    have_systemd || die "需要 systemd。"
  fi
  detect_asset
  init_paths
  ensure_dependencies
  mkdir -p "$ETC_DIR"
  load_or_create_identity
  prompt_inputs
  export_runtime_env
  preflight_conflicts
  verify_domain_points_to_this_host "$DOMAIN"
  if [[ "$TLS_MODE" == "existing" ]]; then
    verify_existing_certificate "$TLS_CERT" "$TLS_KEY" "$DOMAIN" || die "已有证书未通过校验。"
  fi
  assert_udp_port_free "$PORT"
  assert_tcp80_or_existing_cert

  if [[ $SANDBOX -eq 1 ]]; then
    mkdir -p "$BIN_DIR" "$ETC_DIR" "$ACME_DIR" "$LOG_DIR"
    AUTH_PASSWORD="$AUTH_PASSWORD" NODE_NAME="$NODE_NAME" PORT="$PORT" DOMAIN="$DOMAIN" \
      SNI="$SNI" ACME_EMAIL="$ACME_EMAIL" TLS_MODE="$TLS_MODE" TLS_CERT="$TLS_CERT" \
      TLS_KEY="$TLS_KEY" HY2_VERSION="$HY2_VERSION" ACME_DIR="$ACME_DIR" \
      save_state
    write_server_config
    assert_config_policy "$CONFIG_FILE"
    write_client_files
    info "沙箱模式已写入配置与客户端文件，未安装 systemd、未改防火墙或 sysctl。"
    return 0
  fi

  prepare_rollback_snapshots
  local work bin_src
  work="$(mktemp -d "${TMPDIR:-/tmp}/hy2-dl.XXXXXX")"
  # 若已有相同哈希的二进制则跳过下载
  if [[ -x "$BIN_DIR/hysteria" ]] && [[ "$(sha256_of "$BIN_DIR/hysteria")" == "$PINNED_SHA256" ]]; then
    info "已安装的官方二进制哈希与 ${HY2_VERSION} 钉死值一致，跳过下载。"
    bin_src="$BIN_DIR/hysteria"
  else
    bin_src="$(download_and_verify_binary "$work")"
  fi
  verify_binary_version "$bin_src" || { rollback_install; die "官方二进制版本不符合 ${HY2_VERSION}。"; }

  ensure_sysuser
  mkdir -p "$BIN_DIR" "$ETC_DIR" "$ACME_DIR" "$LOG_DIR"
  if [[ "$bin_src" != "$BIN_DIR/hysteria" ]]; then
    install_binary "$bin_src"
  fi
  export_runtime_env
  save_state
  write_server_config
  assert_config_policy "$CONFIG_FILE" || { rollback_install; die "生成的服务端配置不符合既定策略。"; }
  write_client_files
  write_unit
  fix_permissions
  maybe_apply_udp_buffers
  maybe_open_ports
  start_service
  fix_permissions

  info "安装完成。协议：官方 Hysteria 2 ${HY2_VERSION}；证书与 SNI：${SNI}；UDP 端口：${PORT}；显示名：${NODE_NAME}。"
  info "客户端 URI（含密码）已写入受限文件：${LINK_FILE}"
  info "可选 Mihomo 片段（未填写 up/down，避免客户端 Brutal）已写入：${MIHOMO_FILE}"
  info "说明：hysteria2:// URI 不能强制客户端拥塞控制。导入时请勿自行填写过高带宽。"
  if [[ -t 1 ]]; then
    echo "----- 客户端 URI（请当凭据保管，不要发到聊天或日志） -----"
    cat "$LINK_FILE"
    echo
    echo "----- Mihomo 片段（无 up/down） -----"
    cat "$MIHOMO_FILE"
    echo "----------------------------------------------------------------"
  fi
}

