# ---------------------------------------------------------------------------
# 日志（不打印私钥、完整分享链接）
# ---------------------------------------------------------------------------
is_tty() { [[ -t 1 ]]; }

log()  { printf '%s\n' "$*" >&2; }
info() { printf '[信息] %s\n' "$*" >&2; }
warn() { printf '[警告] %s\n' "$*" >&2; }
err()  { printf '[错误] %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

disable_xtrace() {
  case "$-" in
    *x*) return 1 ;;
    *)   return 0 ;;
  esac
}

with_secrets_quiet() {
  # 执行可能触及密钥的命令时关闭 xtrace，避免把私钥打进终端记录
  local xtrace_was=0
  case "$-" in *x*) xtrace_was=1; set +x ;; esac
  "$@"
  local rc=$?
  if [[ $xtrace_was -eq 1 ]]; then set -x; fi
  return "$rc"
}

usage() {
  cat <<EOF
${SCRIPT_NAME} ${SCRIPT_VERSION}
在 Debian / Ubuntu（systemd，amd64 或 arm64）上安装固定版本官方 Xray-core ${XRAY_VERSION}，
部署单节点：VLESS（decryption=none）+ XHTTP（仅随机 path，其余用该版本默认）+ REALITY。
不需要自有域名或 ACME 证书。不会覆盖已有 3x-ui / 官方 xray 安装路径。

用法:
  sudo bash ${SCRIPT_NAME}                 交互安装（需 root）
  sudo bash ${SCRIPT_NAME} --yes           非交互：需已通过环境变量提供备注和端口
  bash ${SCRIPT_NAME} --self-test          本地自检（不安装系统服务、不开端口、不改防火墙）
  bash ${SCRIPT_NAME} --help

常用环境变量:
  XRAY_NODE_REMARK          节点备注（分享链接 # 后的名称）
  XRAY_NODE_PORT            监听端口
  XRAY_NODE_ADDRESS         写入分享链接的服务器地址（IPv4 / IPv6 / 域名）
  XRAY_NODE_TARGET          跳过候选列表选择，改用该域名（仍会做 TLS1.3+h2 检测）
  XRAY_NODE_AUTO_SELECT=1   在候选探测结果中自动选取延迟最低的一项
  XRAY_NODE_OPEN_PORT=yes|no|ask   是否交互放行本机最小端口（默认：有终端则 ask，否则 no）
  XRAY_NODE_RELEASE_BASE    官方 release 下载前缀（仍校验官方校验和；默认 GitHub）
  XRAY_NODE_PREFIX          安装目录（默认 ${DEFAULT_PREFIX}）

一条命令远程安装：本仓库目前没有官方托管地址，请先自行把本脚本放到你信任的 HTTPS 地址，
确认校验后再执行，例如：
  curl -fsSL https://你自己的地址/${SCRIPT_NAME} | sudo bash
不要使用来历不明的一键网址。不要用本脚本替换为最新版 Xray。

${XRAY_VERSION} 是官方预发布（prerelease），本脚本有意钉死该版本，不会自动升级。
官方校验只核对本版本附带的 .dgst 哈希；这不是签名或供应链认证。
EOF
}

