urlencode() {
  python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"
}

valid_port() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  ((10#$p >= 1 && 10#$p <= 65535))
}

valid_domain() {
  local d="$1"
  [[ "$d" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || return 1
  [[ "$d" == *.* ]] || return 1
}

format_host_for_uri() {
  local host="$1"
  if [[ "$host" == \[*\] ]]; then
    printf '%s' "$host"
    return
  fi
  if [[ "$host" == *:* ]]; then
    printf '[%s]' "$host"
    return
  fi
  printf '%s' "$host"
}

ipv6_enabled() {
  [[ -e /proc/net/if_inet6 ]] || return 1
  if [[ -r /proc/sys/net/ipv6/conf/all/disable_ipv6 ]]; then
    [[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6)" == "0" ]] || return 1
  fi
  return 0
}

# ---------------------------------------------------------------------------
# 下载与校验
# ---------------------------------------------------------------------------
diagnose_curl() {
  local url="$1" code="$2" curl_rc="$3"
  err "下载失败：$url"
  err "curl 退出码：${curl_rc}，HTTP 状态：${code:-无}"
  case "$curl_rc" in
    6)  err "诊断：无法解析主机名，请检查 DNS 或到 GitHub 的网络。" ;;
    7)  err "诊断：连不上服务器，请检查出口网络、代理或防火墙。" ;;
    28) err "诊断：连接或传输超时。" ;;
    35) err "诊断：TLS 握手失败，请检查系统时间与证书。" ;;
    22|0)
      if [[ -n "$code" && "$code" != "200" ]]; then
        err "诊断：HTTP ${code}。若是 404，请确认版本 ${XRAY_VERSION} 的资源名未写错；本脚本不会改下最新版。"
      fi
      ;;
    *)  err "诊断：请根据 curl 退出码检查网络。本脚本只从固定地址拉取 ${XRAY_VERSION}。" ;;
  esac
  if [[ -n "${XRAY_NODE_RELEASE_BASE:-}" ]]; then
    info "当前下载前缀：${RELEASE_BASE}"
  else
    info "如 GitHub 不可达，可自行设置 XRAY_NODE_RELEASE_BASE 指向你镜像的同类路径，但仍会校验官方哈希。"
  fi
}

download_file() {
  local url="$1" dest="$2"
  local tmp code rc
  tmp="${dest}.part"
  set +e
  code="$(curl -fsSL --connect-timeout 20 --max-time 300 -A "xray-node-installer/${SCRIPT_VERSION}" \
    -o "$tmp" -w '%{http_code}' "$url")"
  rc=$?
  set -e
  if [[ $rc -ne 0 || "$code" != "200" ]]; then
    diagnose_curl "$url" "$code" "$rc"
    rm -f "$tmp"
    return 1
  fi
  mv -f "$tmp" "$dest"
}

parse_dgst_sha256() {
  local dgst="$1"
  python3 - "$dgst" <<'PY'
import re,sys
text=open(sys.argv[1],encoding='utf-8',errors='replace').read()
m=re.search(r'^(?:SHA2-256|SHA256)\s*=\s*([0-9a-fA-F]{64})\s*$', text, re.M)
if not m:
    sys.exit('无法从官方 .dgst 文件解析 SHA2-256')
print(m.group(1).lower())
PY
}

sha256_of() {
  sha256sum "$1" | awk '{print $1}'
}

download_and_verify_zip() {
  local work="$1"
  local zip_path="${work}/${ASSET_ZIP}"
  local dgst_path="${work}/${ASSET_DGST}"
  local url_zip="${RELEASE_BASE}/${ASSET_ZIP}"
  local url_dgst="${RELEASE_BASE}/${ASSET_DGST}"
  info "下载官方 ${XRAY_VERSION}：${ASSET_ZIP}"
  download_file "$url_dgst" "$dgst_path" || die "无法下载官方校验和文件。"
  download_file "$url_zip" "$zip_path" || die "无法下载官方二进制压缩包。"
  local official_sha file_sha
  official_sha="$(parse_dgst_sha256 "$dgst_path")"
  file_sha="$(sha256_of "$zip_path")"
  if [[ "$official_sha" != "$PINNED_SHA256" ]]; then
    die "官方 .dgst 中的 SHA2-256（${official_sha}）与脚本钉死的哈希（${PINNED_SHA256}）不一致。已中止，既不会改用最新版，也不会忽略校验。"
  fi
  if [[ "$file_sha" != "$official_sha" ]]; then
    die "压缩包 SHA256（${file_sha}）与官方 .dgst（${official_sha}）不一致，已删除并中止。这只是哈希校验，不是签名认证。"
  fi
  info "校验通过：官方 .dgst SHA2-256 与钉死哈希一致。这不是供应链签名认证。"
  printf '%s' "$zip_path"
}

extract_xray() {
  local zip_path="$1" dest_dir="$2"
  mkdir -p "$dest_dir"
  unzip -o -q "$zip_path" -d "$dest_dir"
  [[ -x "${dest_dir}/xray" || -f "${dest_dir}/xray" ]] || die "压缩包中未找到 xray 可执行文件。"
  chmod 0755 "${dest_dir}/xray"
}

verify_binary_version() {
  local bin="$1"
  local out
  out="$("$bin" version 2>&1 || true)"
  printf '%s\n' "$out" | grep -Eq "Xray[[:space:]]+${XRAY_VERSION#v}|${XRAY_VERSION}" \
    || die "解压后的二进制版本不是 ${XRAY_VERSION}。输出为：$(printf '%s' "$out" | tr '\n' ' ' | cut -c1-200)。已中止，不会改用其他版本。"
}

# ---------------------------------------------------------------------------
# 身份：首次生成，重跑保留；私钥单独存放，权限严格，不向标准输出打印
# ---------------------------------------------------------------------------
rand_hex() {
  local n="${1:-8}"
  python3 -c "import secrets; print(secrets.token_hex(int($n)//2))"
}

rand_path() {
  python3 - <<'PY'
import secrets,string
alphabet=string.ascii_letters+string.digits
print('/'+''.join(secrets.choice(alphabet) for _ in range(18)))
PY
}

parse_x25519() {
  python3 -c 'import sys,re
text=sys.stdin.read()
pk=re.search(r"^PrivateKey:\s*(\S+)\s*$", text, re.M)
pub=re.search(r"^Password \(PublicKey\):\s*(\S+)\s*$", text, re.M)
if not pk or not pub:
    sys.stderr.write("无法解析 xray x25519 输出（v26.6.27 应为 PrivateKey / Password (PublicKey)）。\n")
    sys.exit(2)
print(pk.group(1))
print(pub.group(1))
'
}

gen_identity_with_bin() {
  local bin="$1"
  local uuid short path priv pub parsed
  uuid="$("$bin" uuid)"
  [[ "$uuid" =~ ^[0-9a-fA-F-]{36}$ ]] || die "xray uuid 输出异常。"
  short="$(rand_hex 8)"
  path="$(rand_path)"
  parsed="$(with_secrets_quiet "$bin" x25519 | parse_x25519)" || die "生成 X25519 密钥对失败。"
  priv="${parsed%%$'\n'*}"
  pub="${parsed#*$'\n'}"
  printf '%s\n' "$uuid" "$short" "$path" "$priv" "$pub"
}

write_secret_file() {
  local dest="$1" mode="$2"
  local tmp
  tmp="${dest}.tmp"
  umask 077
  cat >"$tmp"
  chmod "$mode" "$tmp"
  mv -f "$tmp" "$dest"
}

write_state() {
  local remark="$1" port="$2" uuid="$3" short="$4" path="$5" pub="$6"
  local target="$7" sni="$8" names="$9" listen="${10}" address="${11}"
  XRAY_NODE_STATE_REMARK="$remark" \
  XRAY_NODE_STATE_PORT="$port" \
  XRAY_NODE_STATE_UUID="$uuid" \
  XRAY_NODE_STATE_SHORT="$short" \
  XRAY_NODE_STATE_PATH="$path" \
  XRAY_NODE_STATE_PUB="$pub" \
  XRAY_NODE_STATE_TARGET="$target" \
  XRAY_NODE_STATE_SNI="$sni" \
  XRAY_NODE_STATE_NAMES="$names" \
  XRAY_NODE_STATE_LISTEN="$listen" \
  XRAY_NODE_STATE_ADDRESS="$address" \
  XRAY_NODE_STATE_VERSION="$XRAY_VERSION" \
  python3 - "$STATE_FILE" <<'PY'
import json,os,sys
path=sys.argv[1]
names=[x for x in os.environ.get("XRAY_NODE_STATE_NAMES","").split(",") if x]
data={
  "version": os.environ["XRAY_NODE_STATE_VERSION"],
  "remark": os.environ["XRAY_NODE_STATE_REMARK"],
  "port": int(os.environ["XRAY_NODE_STATE_PORT"]),
  "uuid": os.environ["XRAY_NODE_STATE_UUID"],
  "short_id": os.environ["XRAY_NODE_STATE_SHORT"],
  "path": os.environ["XRAY_NODE_STATE_PATH"],
  "public_key": os.environ["XRAY_NODE_STATE_PUB"],
  "target": os.environ["XRAY_NODE_STATE_TARGET"],
  "sni": os.environ["XRAY_NODE_STATE_SNI"],
  "server_names": names,
  "listen": os.environ["XRAY_NODE_STATE_LISTEN"],
  "address": os.environ.get("XRAY_NODE_STATE_ADDRESS",""),
}
tmp=path+".tmp"
fd=os.open(tmp, os.O_WRONLY|os.O_CREAT|os.O_TRUNC, 0o600)
with os.fdopen(fd,"w",encoding="utf-8") as f:
    json.dump(data,f,ensure_ascii=False,indent=2)
    f.write("\n")
os.replace(tmp, path)
os.chmod(path, 0o600)
PY
}

