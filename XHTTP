build_share_uri() {
  python3 - <<'PY'
import os,urllib.parse
uuid=os.environ["URI_UUID"]
host=os.environ["URI_HOST"]
port=os.environ["URI_PORT"]
sni=os.environ["URI_SNI"]
pbk=os.environ["URI_PBK"]
sid=os.environ["URI_SID"]
path=os.environ["URI_PATH"]
remark=os.environ["URI_REMARK"]
if host and not (host.startswith("[") and host.endswith("]")) and ":" in host:
    host=f"[{host}]"
q=urllib.parse.urlencode({
