maybe_open_port() {
  local mode="${OPEN_PORT_MODE}"
  if [[ -z "$mode" ]]; then
    if [[ -t 0 ]]; then
      mode='ask'
    else
      mode='no'
    fi
  fi
  case "$mode" in
    no|NO|0) return 0 ;;
    yes|YES|1) ;;
    ask|ASK)
      if confirm "是否仅放行本机端口 ${PORT}/tcp（不改默认策略、不改 SSH，云厂商安全组仍需你自己开）？"; then
        mode='yes'
      else
        info "已跳过本机端口放行。若在云服务器上，还需在安全组放行 ${PORT}/tcp。"
        return 0
      fi
      ;;
    *) die "XRAY_NODE_OPEN_PORT 只能是 yes、no 或 ask。" ;;
  esac
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
    ufw allow "${PORT}/tcp" comment 'xray-node' || die "ufw 放行失败。"
    info "已通过 ufw 放行 ${PORT}/tcp。"
    return 0
  fi
  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -q running; then
    firewall-cmd --permanent --add-port="${PORT}/tcp" || die "firewalld 放行失败。"
    firewall-cmd --reload || true
    info "已通过 firewalld 放行 ${PORT}/tcp。"
    return 0
  fi
  warn "未检测到已启用的 ufw 或 firewalld。本脚本不会擅自改 iptables/nft 默认策略。请自行放行 ${PORT}/tcp，并检查云防火墙/安全组。"
}

start_service() {
  systemctl enable "$UNIT_NAME"
  if ! systemctl start "$UNIT_NAME"; then
    err "服务启动失败。"
    systemctl status "$UNIT_NAME" --no-pager -l || true
    rollback_install
    die "已回滚到安装前状态（若为首次安装则已禁用并移除新单元）。"
  fi
  SERVICE_STARTED_THIS_RUN=1
  if ! systemctl is-active --quiet "$UNIT_NAME"; then
    rollback_install
    die "服务未能保持运行，已回滚。"
  fi
  info "服务已启用并启动：${UNIT_NAME}"
}

