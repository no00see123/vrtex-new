need_cmd() {
  local c
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || die "缺少命令：$c。请先安装后再运行（本脚本不会擅自全局安装软件包）。"
  done
}

os_id() {
  local id=''
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    id="$(. /etc/os-release && printf '%s' "${ID:-}")"
  fi
  printf '%s' "$id"
}

os_supported() {
  case "$(os_id)" in
    debian|ubuntu) return 0 ;;
    *) return 1 ;;
  esac
}

detect_asset() {
  local m
  m="$(uname -m)"
  case "$m" in
    x86_64|amd64)
      ASSET_ZIP='Xray-linux-64.zip'
      PINNED_SHA256="$PINNED_SHA256_LINUX_64"
      ;;
    aarch64|arm64)
      ASSET_ZIP='Xray-linux-arm64-v8a.zip'
      PINNED_SHA256="$PINNED_SHA256_LINUX_ARM64"
      ;;
    *)
      die "不支持的架构：$m。仅支持 amd64（x86_64）与 arm64（aarch64）。"
      ;;
  esac
  ASSET_DGST="${ASSET_ZIP}.dgst"
}

