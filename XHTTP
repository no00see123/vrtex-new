# ---------------------------------------------------------------------------
# REALITY 目标探测：仅预置域名，TLS 应用握手，不扫公网
# ---------------------------------------------------------------------------
probe_domains_py() {
  python3 - "$PROBE_ROUNDS" "$PROBE_TIMEOUT" "$PROBE_PORT" "$@" <<'PY'
import json,socket,ssl,statistics,sys,time
rounds=int(sys.argv[1]); timeout=float(sys.argv[2]); port=int(sys.argv[3])
domains=sys.argv[4:]

def sans_of(cert):
    names=[]
    for typ,val in cert.get("subjectAltName",()):
        if typ=="DNS" and val:
            names.append(val)
    return names

def exact_server_names(host, san_list):
    out=[]
    def add(n):
        n=n.strip()
        if not n or n.startswith("*"):  # 官方 serverNames 不支持通配符
            return
        if n not in out:
            out.append(n)
    add(host)
    for n in san_list:
        add(n)
    return out[:8]

def issuer_text(cert):
    parts=[]
    for rdn in cert.get("issuer",()):
        for k,v in rdn:
            parts.append(f"{k}={v}")
    return ", ".join(parts)

def handshake_once(host, ip, family):
    ctx=ssl.create_default_context()
    ctx.minimum_version=ssl.TLSVersion.TLSv1_3
    ctx.set_alpn_protocols(["h2"])
    sock=socket.socket(family, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    try:
        sock.connect((ip, port))
        t0=time.perf_counter()
        ssock=ctx.wrap_socket(sock, server_hostname=host)
        try:
            ms=(time.perf_counter()-t0)*1000.0
            ver=ssock.version()
            alpn=ssock.selected_alpn_protocol()
            cert=ssock.getpeercert()
            if ver!="TLSv1.3":
                raise ssl.SSLError(f"协商到 {ver}，不是 TLS 1.3")
            if alpn!="h2":
                raise ssl.SSLError(f"ALPN={alpn!r}，不是 h2")
            if not cert:
                raise ssl.SSLError("未取得对端证书")
            return {
                "ms": ms,
                "sans": sans_of(cert),
                "issuer": issuer_text(cert),
            }
        finally:
            try:
                ssock.close()
            except Exception:
                pass
    finally:
        try:
            sock.close()
        except Exception:
            pass

def resolve(host, family):
    try:
        infos=socket.getaddrinfo(host, port, family, socket.SOCK_STREAM)
    except socket.gaierror:
        return []
    ips=[]
    for info in infos:
        ip=info[4][0]
        if ip not in ips:
            ips.append(ip)
    return ips[:1]  # 每个地址族只测第一个，避免扩大探测面

results=[]
for host in domains:
    fams=[("IPv4", socket.AF_INET)]
    if getattr(socket, "has_ipv6", False):
        fams.append(("IPv6", socket.AF_INET6))
    best=None
    errors=[]
    for label,fam in fams:
        ips=resolve(host, fam)
        if not ips:
            continue
        ip=ips[0]
        samples=[]
        last=None
        fail=None
        for _ in range(rounds):
            try:
                last=handshake_once(host, ip, fam)
                samples.append(last["ms"])
            except Exception as e:
                fail=f"{label} {ip}: {e}"
                break
        if len(samples)==rounds and last:
            med=statistics.median(samples)
            rec={
                "domain": host,
                "family": label,
                "ip": ip,
                "median_ms": round(med, 2),
                "samples_ms": [round(x,2) for x in samples],
                "sans": last["sans"],
                "issuer": last["issuer"],
                "server_names": exact_server_names(host, last["sans"]),
                "cdn_warn": bool(
                    ("cloudflare" in (last["issuer"]+" "+host).lower())
                    or ("fastly" in last["issuer"].lower())
                ),
            }
            if best is None or rec["median_ms"] < best["median_ms"]:
                best=rec
        elif fail:
            errors.append(fail)
    if best:
        results.append(best)
    else:
        results.append({
            "domain": host,
            "error": "; ".join(errors) if errors else "无法解析或握手未达到 TLS 1.3 + h2 + 有效证书",
        })

ok=[r for r in results if "median_ms" in r]
ok.sort(key=lambda r: (r["median_ms"], r["domain"], r["family"]))
bad=[r for r in results if "median_ms" not in r]
print(json.dumps({"ok":ok, "failed":bad}, ensure_ascii=False, indent=2))
PY
}

print_probe_table() {
  python3 -c "import json,sys
data=json.load(sys.stdin)
ok=data.get('ok') or []
if not ok:
    print('没有可用的候选站点。', file=sys.stderr)
    raise SystemExit(0)
print('序号  中位握手(ms)  地址族  域名                          说明', file=sys.stderr)
for i,r in enumerate(ok,1):
    note=''
    if r.get('cdn_warn'):
        note='可能为 CDN，回落转发有被滥用风险，请谨慎'
    print('%4d  %10.2f  %-5s  %-28s %s' % (i, r['median_ms'], r['family'], r['domain'], note), file=sys.stderr)
print('以上延迟为多次 TLS 握手的中位数，不是 ICMP，也不能保证地理最近或长期稳定。', file=sys.stderr)
" >&2
}

# ---------------------------------------------------------------------------
# 交互
# ---------------------------------------------------------------------------
ask() {
  local prompt="$1" default="${2:-}"
  local ans
  if [[ -n "$default" ]]; then
    read -r -p "$prompt [$default]: " ans || true
    printf '%s' "${ans:-$default}"
  else
    read -r -p "$prompt: " ans || true
    printf '%s' "$ans"
  fi
}

confirm() {
  local prompt="$1"
  if [[ $ASSUME_YES -eq 1 ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    return 1
  fi
  local ans
  read -r -p "$prompt [y/N]: " ans || true
  case "$ans" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

collect_remark_port() {
  local remark port
  remark="${XRAY_NODE_REMARK:-}"
  port="${XRAY_NODE_PORT:-}"
  if [[ -z "$remark" ]]; then
    if [[ -t 0 ]]; then
      remark="$(ask '节点备注（将作为客户端中的名称）')"
    else
      die "非交互模式请设置环境变量 XRAY_NODE_REMARK。"
    fi
  fi
  remark="$(printf '%s' "$remark" | tr -d '\r\n')"
  [[ -n "$remark" ]] || die "备注不能为空。"
  [[ ${#remark} -le 80 ]] || die "备注过长（最多 80 字符）。"
  if [[ -z "$port" ]]; then
    if [[ -t 0 ]]; then
      port="$(ask '端口号' '443')"
    else
      die "非交互模式请设置环境变量 XRAY_NODE_PORT。"
    fi
  fi
  valid_port "$port" || die "端口无效：$port"
  if [[ "$port" == "22" ]]; then
    die "拒绝使用 22 端口，以免与 SSH 冲突。"
  fi
  if port_in_use "$port" && ! our_service_owns_port "$port"; then
    die "端口 ${port} 已被占用。本脚本不会停止现有服务，请换端口或自行处理冲突。"
  fi
  REMARK="$remark"
  PORT="$port"
}

choose_listen() {
  if ipv6_enabled; then
    LISTEN='::'
  else
    LISTEN='0.0.0.0'
  fi
}

detect_public_address() {
  local v4='' v6=''
  local svc
  for svc in \
      'https://api.ipify.org' \
      'https://ifconfig.me/ip' \
      'https://icanhazip.com'
  do
    if [[ -z "$v4" ]]; then
      v4="$(curl -4 -fsS --connect-timeout 5 --max-time 10 "$svc" 2>/dev/null | tr -d '[:space:]' || true)"
      [[ "$v4" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || v4=''
    fi
    if ipv6_enabled && [[ -z "$v6" ]]; then
      v6="$(curl -6 -fsS --connect-timeout 5 --max-time 10 "$svc" 2>/dev/null | tr -d '[:space:]' || true)"
      [[ "$v6" == *:* ]] || v6=''
    fi
    [[ -n "$v4" ]] && break
  done
  if [[ -n "${XRAY_NODE_ADDRESS:-}" ]]; then
    SERVER_ADDRESS="$XRAY_NODE_ADDRESS"
    return
  fi
  if [[ -n "$v4" ]]; then
    SERVER_ADDRESS="$v4"
    return
  fi
  if [[ -n "$v6" ]]; then
    SERVER_ADDRESS="$v6"
    return
  fi
  if [[ -t 0 ]]; then
    SERVER_ADDRESS="$(ask '未能自动检测公网地址，请输入写入分享链接的 IP 或域名')"
  else
    die "无法检测公网地址。请设置 XRAY_NODE_ADDRESS。"
  fi
  [[ -n "$SERVER_ADDRESS" ]] || die "服务器地址不能为空。"
}

select_target() {
  local forced="${XRAY_NODE_TARGET:-}"
  local raw choice idx
  if [[ -n "$forced" ]]; then
    valid_domain "$forced" || die "XRAY_NODE_TARGET 不是合法域名：$forced"
    info "将按你指定的域名做 TLS 1.3 + h2 + 证书检测：${forced}"
    raw="$(probe_domains_py "$forced")"
    python3 -c 'import json,sys; d=json.loads(sys.stdin.read());
raise SystemExit(0 if d.get("ok") else 1)' <<<"$raw" \
      || die "指定域名未通过 TLS 1.3、h2、有效证书与 SNI 匹配检测，已中止。不会写无效 target。"
    _apply_probe_choice "$raw" 1
    return
  fi
  info "正在从当前机器探测预置大厂站点（TLS 握手，不是 ping；不扫描公网）……"
  raw="$(probe_domains_py "${CANDIDATE_DOMAINS[@]}")"
  local n_ok
  n_ok="$(python3 -c 'import json,sys; print(len(json.loads(sys.stdin.read()).get("ok") or []))' <<<"$raw")"
  if [[ "$n_ok" == "0" ]]; then
    err "预置候选均未通过检测。失败摘要："
    python3 -c 'import json,sys
d=json.loads(sys.stdin.read())
for r in d.get("failed") or []:
    print("  %s: %s" % (r.get("domain"), r.get("error")))
' <<<"$raw" >&2
    if [[ -t 0 ]]; then
      forced="$(ask '请输入一个要再检测的域名（将作为 REALITY target，需支持 TLS1.3+h2）')"
      valid_domain "$forced" || die "域名无效。"
      raw="$(probe_domains_py "$forced")"
      python3 -c 'import json,sys; raise SystemExit(0 if json.loads(sys.stdin.read()).get("ok") else 1)' <<<"$raw" \
        || die "该域名未通过检测。"
      _apply_probe_choice "$raw" 1
      return
    fi
    die "没有可用目标。可设置 XRAY_NODE_TARGET 指定域名后重试。"
  fi
  printf '%s\n' "$raw" | print_probe_table
  if [[ $AUTO_SELECT -eq 1 ]]; then
    info "已按 XRAY_NODE_AUTO_SELECT 选择延迟最低的候选。"
    _apply_probe_choice "$raw" 1
    return
  fi
  if [[ ! -t 0 ]]; then
    die "非交互模式请设置 XRAY_NODE_AUTO_SELECT=1，或提供 XRAY_NODE_TARGET。"
  fi
  while true; do
    choice="$(ask "请选择序号（1-${n_ok}）")"
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= n_ok )); then
      _apply_probe_choice "$raw" "$choice"
      return
    fi
    warn "请输入有效序号。"
  done
}

_apply_probe_choice() {
  local raw="$1" idx="$2"
  local rec
  rec="$(PROBE_JSON="$raw" python3 -c 'import json,os,sys
idx=int(sys.argv[1])
d=json.loads(os.environ["PROBE_JSON"])
ok=d["ok"]
if idx<1 or idx>len(ok):
    raise SystemExit("序号超出范围")
r=ok[idx-1]
print(r["domain"])
print(r["family"])
print(",".join(r["server_names"]))
print("1" if r.get("cdn_warn") else "0")
print("%.2f" % r["median_ms"])
' "$idx")"
  local domain family names cdn med
  domain="$(printf '%s\n' "$rec" | sed -n '1p')"
  family="$(printf '%s\n' "$rec" | sed -n '2p')"
  names="$(printf '%s\n' "$rec" | sed -n '3p')"
  cdn="$(printf '%s\n' "$rec" | sed -n '4p')"
  med="$(printf '%s\n' "$rec" | sed -n '5p')"
  TARGET="${domain}:443"
  SNI="$domain"
  SERVER_NAMES="$names"
  if [[ "$cdn" == "1" ]]; then
    warn "该目标证书或域名可能与 CDN 相关。REALITY 会把未通过认证的流量回落到 target，存在被滥用风险。已按你的选择写入，不会自动改选。"
  fi
  info "已选择 ${TARGET}（${family}，中位握手 ${med} ms），客户端 SNI=${SNI}"
}

